<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script SYSTEM "script.dtd">
<!--
  Pipeline Integrity Management for Maximo Manage - part 2 of 3: application.
  Every row is guarded (inserted only if missing): safe to re-run. Restart Manage after install so
  menus, grants and end points are reloaded.
-->
<script author="Mohamed Chihaoui" scriptname="pim_02_app_1.0.0">
  <description>PIM: Pipeline Integrity application, toolbar, security options and PIM module</description>
  <statements>
    <create_app app="PIMASSESS" description="Pipeline Integrity" skipnavigation="false" orderby="assessnum desc" maintbname="PIMASSESS"/>
    <add_sigoption app="PIMASSESS" optionname="READ" description="Access Pipeline Integrity" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <add_sigoption app="PIMASSESS" optionname="INSERT" description="New assessment" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <add_sigoption app="PIMASSESS" optionname="SAVE" description="Save assessment" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <add_sigoption app="PIMASSESS" optionname="DELETE" description="Delete assessment" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <add_sigoption app="PIMASSESS" optionname="CLEAR" description="Clear changes" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <add_sigoption app="PIMASSESS" optionname="PREVIOUS" description="Previous record" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <add_sigoption app="PIMASSESS" optionname="NEXT" description="Next record" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <add_sigoption app="PIMASSESS" optionname="BOOKMARK" description="Add to bookmarks" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <add_sigoption app="PIMASSESS" optionname="ASSETDETAILS" description="View asset" esigenabled="false" visible="true" grantapp="ASSET" grantoption="READ"/>
    <insert table="MAXPRESENTATION"><insertrow>
      <columnvalue column="APP" string="PIMASSESS"/>
      <columnvalue column="PRESENTATION" clob=""/>
    </insertrow></insert>
    <create_app_menu app="PIMASSESS" type="tool">
      <app_menu_option option="INSERT" image="nav_icon_insert.gif" tabdisplay="ALL"/>
      <app_menu_option option="SAVE" image="nav_icon_save.gif" tabdisplay="MAIN"/>
      <app_menu_option option="CLEAR" image="nav_icon_clear.gif" tabdisplay="MAIN"/>
      <menu_separator tabdisplay="MAIN"/>
      <app_menu_option option="PREVIOUS" image="nav_icon_previous.gif" tabdisplay="MAIN"/>
      <app_menu_option option="NEXT" image="nav_icon_next.gif" tabdisplay="MAIN"/>
    </create_app_menu>
    <create_app_menu app="PIMASSESS" type="search">
      <app_menu_option option="BOOKMARK" tabdisplay="ALL"/>
    </create_app_menu>
    <create_module module="PIM" description="Pipeline Integrity" menu_position="last" skipnavigation="false" skipentitlement="false">
      <module_menu_app app="PIMASSESS" pinned="Y"/>
    </create_module>
    <freeform description="set MAXAPPS.ORIGINALAPP">
      <sql target="sqlserver"><![CDATA[update maxapps set originalapp=app, ismobile=0 where app='PIMASSESS' and originalapp is null]]></sql>
      <sql target="oracle"><![CDATA[update maxapps set originalapp=app, ismobile=0 where app='PIMASSESS' and originalapp is null]]></sql>
      <sql target="db2"><![CDATA[update maxapps set originalapp=app, ismobile=0 where app='PIMASSESS' and originalapp is null]]></sql>
    </freeform>
  </statements>
</script>
