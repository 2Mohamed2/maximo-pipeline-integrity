', 8) || 'ft = f["ftype"]' || CHR(10) || REPEAT(' ', 8) || 'key = {"DENT": "TPD", "CRACK": "SCC"}.get(ft) or ("INT" if r.getString("SURFACE") == "INT" else "EXT")' || CHR(10) || REPEAT(' ', 8) || 'if ft == "DENTML":' || CHR(10) || REPEAT(' ', 12) || 'mech = surf["TPD"]' || CHR(10) || REPEAT(' ', 12) || 'mech["n"] += 1' || CHR(10) || REPEAT(' ', 12) || 'mech["i"] += resp == "IMMEDIATE"' || CHR(10) || REPEAT(' ', 8) || 'sk = surf[key]' || CHR(10) || REPEAT(' ', 8) || 'sk["n"] += 1' || CHR(10) || REPEAT(' ', 8) || 'if sk is not None:' || CHR(10) || REPEAT(' ', 12) || 'sk["i"] += resp == "IMMEDIATE"' || CHR(10) || REPEAT(' ', 12) || 'sk["s"] += resp == "SCHEDULED"' || CHR(10) || REPEAT(' ', 12) || 'if resp == "MONITORED":' || CHR(10) || REPEAT(' ', 16) || 'sk["life"] = min(sk["life"], life)' || CHR(10) || REPEAT(' ', 8) || 'if e["erf"] > max_erf:' || CHR(10) || REPEAT(' ', 12) || 'max_erf, worst = e["erf"], r.getString("FEATURENUM")' || CHR(10) || REPEAT(' ', 8) || 'if resp == "MONITORED":' || CHR(10) || REPEAT(' ', 12) || 'min_ratio = min(min_ratio, e["ratio"])' || CHR(10) || REPEAT(' ', 12) || 'min_life = min(min_life, life)' || CHR(10) || REPEAT(' ', 8) || 'if resp == "IMMEDIATE":' || CHR(10) || REPEAT(' ', 12) || 'due = rep' || CHR(10) || REPEAT(' ', 8) || 'elif resp == "SCHEDULED":' || CHR(10) || REPEAT(' ', 12) || 'due = add_years(rep, 1.0) if rep is not None else None' || CHR(10) || REPEAT(' ', 8) || 'else:' || CHR(10) || REPEAT(' ', 12) || 'due = add_years(ili, life) if (ili is not None and life < 99.0) else None' || CHR(10) || REPEAT(' ', 8) || 'for k, v in (("GROWTH", round(g, 3)), ("PF", round(e["pf"] * 10.0, 1)), ("PSAFE", round(e["psafe"] * 10.0, 1)),' || CHR(10) || REPEAT(' ', 21) || '("ERF", round(e["erf"], 3)), ("PFRATIO", round(e["ratio"], 3)), ("RESPONSE", resp),' || CHR(10) || REPEAT(' ', 21) || '("REMLIFE", round(life, 1) if life < 99.0 else None), ("DUEDATE", due)):' || CHR(10) || REPEAT(' ', 12) || 'setv(r, k, v)' || CHR(10) || REPEAT(' ', 8) || 'r