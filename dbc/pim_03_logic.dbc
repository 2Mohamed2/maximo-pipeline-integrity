_level(pofcat, cof), yrs, why, " ".join(notes)))') || CHR(10) || RPAD(' ', 4) || TO_CLOB('setv(a, "CALCNOTE", note[:1000])') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('if not _frozen:') || CHR(10) || RPAD(' ', 4) || TO_CLOB('_run()') || CHR(10) from dual where not exists (select 1 from autoscript where autoscript='PIM.CALC')]]></sql>
      <sql target="oracle"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMCALCSAVE', 'PIM.CALC', 'Recalculate the integrity assessment before every save', 'OBJECT', 'PIMASSESS', 6, null, 1, scriptlaunchpointseq.nextval from dual where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMCALCSAVE')]]></sql>
      <sql target="oracle"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMCALC', 'PIM.CALC', 'Recalculate Integrity', 'ACTION', 'PIMASSESS', null, null, 1, scriptlaunchpointseq.nextval from dual where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMCALC')]]></sql>
      <sql target="oracle"><![CDATA[insert into action (actionid, action, description, objectname, type, value, parameter, langcode, usewith, hasld) select actionseq.nextval, 'PIMCALC', 'Recalculate Integrity', 'PIMASSESS', 'CUSTOM', 'com.ibm.tivoli.maximo.script.ScriptAction', 'PIM.CALC,PIMCALC,PIMCALC', 'EN', 'ALL', 0 from dual where not exists (select 1 from action where action='PIMCALC')]]></sql>
      <sql target="db2"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.CALC', 'Active', current timestamp, current timestamp, current timestamp, 'MAXADMIN', nextval for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: B31G failure pressure, B31.8S response, threats, consequence, risk and interval', '1.0.0', CAST('# PIM.CALC - pipeline integrity calculation structured after ASME B31.8S and Modified B31G.' AS CLOB) || CHR(10) || '# Pipeline integrity calculation core, structured after ASME B31.8S (integrity management of gas pipelines)' || CHR(10) || '# and ASME B31G (remaining strength of corroded pipelines, Modified B31G / 0.85dL method).' || CHR(10) || '# Pure functions only: this text is embedded in the PIM.CALC automation script (Jython 2.7)' || CHR(10) || '# and imported by the test harness (CPython 3), so keep it compatible with both.' || CHR(10) || 'import math' || CHR(10) || CHR(10) || '# ---- Published formulas and limits ------------------------------------------------------------------------' || CHR(10) || '# VERIFY against your licensed copies of ASME B31.8S and B31G before production use; keep under change control.' || CHR(10) || 'FLOW_ADD = 69.0' || REPEAT(' ', 12) || '# MPa: Modified B31G flow stress = SMYS + 69 MPa (10 ksi)' || CHR(10) || 'DEPTH_IMMEDIATE = 0.80' || REPEAT(' ', 5) || '# B31.8S 7.2.1: metal loss deeper than 80 % of wall -> immediate response' || CHR(10) || 'PF_IMMEDIATE = 1.10' || REPEAT(' ', 8) || '# B31.8S 7.2.1: predicted failure pressure below 1.1 x MAOP -> immediate response' || CHR(10) || 'DENT_SCHEDULED = 6.0' || REPEAT(' ', 7) || '# B31.8S 7.2.2: plain dent deeper than 6 % of the diameter -> scheduled response' || CHR(10) || 'PIR_K = 0.099' || REPEAT(' ', 14) || '# B31.8S 3.2 (SI): potential impact radius r = 0.099 * sqrt(d^2 * p), d mm, p MPa -> m' || CHR(10) || 'DESIGN_F = {"1": 0.72, "2": 0.60, "3": 0.50, "4": 0.40}' || REPEAT(' ', 3) || '# ASME B31.8 design factor by class location' || CHR(10) || '# B31.8S Table 3, time-dependent threats, ILI or pressure test: (hoop stress band lower limit in %SMYS,' || CHR(10) || '# [(minimum predicted failure pressure ratio Pf/MAOP, interval in years), ...] longest interval first)' || CHR(10) || 'TABLE3 = ((50.0, ((1.39, 10.0), (1.25, 5.0))),' || CHR(10) || REPEAT(' ', 10) || '(30.0, ((1.70, 15.0), (1.40, 10.0))),' || CHR(10) || REPEAT(' ', 10) || '(0.0, ((2.20, 20.0), (2.00, 15.0), (1.65, 10.0))))' || CHR(10) || CHR(10) || '# ---- Company-configurable screening values (relative risk model, B31.8S 5.7 index approach) ---------------' || CHR(10) || 'SUSC_SCORE = {"HIGH": 4, "MEDIUM": 3, "LOW": 2, "NONE": 0}' || CHR(10) || 'COF_FIN = (1e4, 1e5, 1e6, 1e7)' || REPEAT(' ', 10) || '# financial CoF category A..E upper limits (USD), same scale as the RBI module' || CHR(10) || 'RISK_LEVEL = ((4, "LOW"), (6, "MEDIUM"), (7, "MEDHIGH"), (10, "HIGH"))' || REPEAT(' ', 3) || '# matrix score = PoF cat + CoF index' || CHR(10) || 'THREATS = ("EXTCORR", "INTCORR", "SCC", "MFG", "CONSTR", "EQUIP", "TPD", "INCOPS", "WEATHER")' || CHR(10) || 'ILI_THREATS = ("EXTCORR", "INTCORR")' || REPEAT(' ', 4) || '# time-dependent metal-loss threats scored from the ILI results' || CHR(10) || CHR(10) || CHR(10) || 'def b31g_mod(od, wt, smys, depth_mm, length_mm):' || CHR(10) || REPEAT(' ', 4) || '"""Modified B31G (0.85dL) predicted failure pressure in MPa for one metal-loss feature."""' || CHR(10) || REPEAT(' ', 4) || 'if wt <= 0 or od <= 0:' || CHR(10) || REPEAT(' ', 8) || 'return 0.0' || CHR(10) || REPEAT(' ', 4) || 'dt = min(max(depth_mm / wt, 0.0), 0.999)' || CHR(10) || REPEAT(' ', 4) || 'z = length_mm ** 2 / (od * wt)' || CHR(10) || REPEAT(' ', 4) || 'if z <= 50.0:' || CHR(10) || REPEAT(' ', 8) || 'm = math.sqrt(1.0 + 0.6275 * z - 0.003375 * z * z)' || CHR(10) || REPEAT(' ', 4) || 'else:' || CHR(10) || REPEAT(' ', 8) || 'm = 0.032 * z + 3.3' || CHR(10) || REPEAT(' ', 4) || 'sflow = smys + FLOW_ADD' || CHR(10) || REPEAT(' ', 4) || 'sf = sflow * (1.0 - 0.85 * dt) / (1.0 - 0.85 * dt / m)' || CHR(10) || REPEAT(' ', 4) || 'return 2.0 * sf * wt / od' || CHR(10) || CHR(10) || CHR(10) || 'def hoop_pct(maop_mpa, od, wt, smys):' || CHR(10) || REPEAT(' ', 4) || '"""Hoop stress at MAOP as a percentage of SMYS (Barlow)."""' || CHR(10) || REPEAT(' ', 4) || 'return 100.0 * maop_mpa * od / (2.0 * wt * smys)' || CHR(10) || CHR(10) || CHR(10) || 'def pir(od, maop_mpa):' || CHR(10) || REPEAT(' ', 4) || '"""Potential impact radius (m)."""' || CHR(10) || REPEAT(' ', 4) || 'return PIR_K * math.sqrt(od * od * maop_mpa)' || CHR(10) || CHR(10) || CHR(10) || 'def feature_eval(f, seg, years_since_ili=0.0):' || CHR(10) || REPEAT(' ', 4) || '"""Evaluate one anomaly at a time point years_since_ili after the ILI run.' || CHR(10) || REPEAT(' ', 4) || 'f: dict(ftype, depthpct, length, dentpct, growth) ; seg: dict(od, wt, smys, maop (MPa), sf)' || CHR(10) || REPEAT(' ', 4) || 'Returns dict(depth, pf, psafe, erf, ratio, response)."""' || CHR(10) || REPEAT(' ', 4) || 'depth = f["depthpct"] / 100.0 * seg["wt"] + f.get("growth", 0.0) * years_since_ili' || CHR(10) || REPEAT(' ', 4) || 'ftype = f["ftype"]' || CHR(10) || REPEAT(' ', 4) || 'if ftype in ("METALLOSS", "DENTML"):' || CHR(10) || REPEAT(' ', 8) || 'pf = b31g_mod(seg["od"], seg["wt"], seg["smys"], depth, f["length"])' || CHR(10) || REPEAT(' ', 4) || 'else:' || REPEAT(' ', 3) || '# dents and cracks: the pipe body is not thinned; failure pressure of the intact pipe' || CHR(10) || REPEAT(' ', 8) || 'pf = 2.0 * (seg["smys"] + FLOW_ADD) * seg["wt"] / seg["od"]' || CHR(10) || REPEAT(' ', 4) || 'psafe = pf * seg["sf"]' || CHR(10) || REPEAT(' ', 4) || 'erf = seg["maop"] / psafe if psafe > 0 else 99.0' || CHR(10) || REPEAT(' ', 4) || 'ratio = pf / seg["maop"] if seg["maop"] > 0 else 99.0' || CHR(10) || REPEAT(' ', 4) || 'if ftype in ("DENTML", "CRACK") or depth / seg["wt"] > DEPTH_IMMEDIATE or ratio < PF_IMMEDIATE:' || CHR(10) || REPEAT(' ', 8) || 'resp = "IMMEDIATE"' || CHR(10) || REPEAT(' ', 4) || 'elif erf >= 1.0 or (ftype == "DENT" and f.get("dentpct", 0.0) > DENT_SCHEDULED):' || CHR(10) || REPEAT(' ', 8) || 'resp = "SCHEDULED"' || CHR(10) || REPEAT(' ', 4) || 'else:' || CHR(10) || REPEAT(' ', 8) || 'resp = "MONITORED"' || CHR(10) || REPEAT(' ', 4) || 'return dict(depth=depth, pf=pf, psafe=psafe, erf=erf, ratio=ratio, response=resp)' || CHR(10) || CHR(10) || CHR(10) || 'def remaining_life(f, seg, horizon=30.0):' || CHR(10) || REPEAT(' ', 4) || '"""Years from the ILI run until a monitored metal-loss feature needs repair (ERF reaches 1 or it turns' || CHR(10) || REPEAT(' ', 4) || 'immediate), with its depth growing at f[''growth''] mm/y. 99 when it never does within the horizon."""' || CHR(10) || REPEAT(' ', 4) || 'if f["ftype"] != "METALLOSS" or f.get("growth", 0.0) <= 0:' || CHR(10) || REPEAT(' ', 8) || 'return 99.0' || CHR(10) || REPEAT(' ', 4) || 't = 0.0' || CHR(10) || REPEAT(' ', 4) || 'while t <= horizon:' || CHR(10) || REPEAT(' ', 8) || 'if feature_eval(f, seg, t)["response"] != "MONITORED":' || CHR(10) || REPEAT(' ', 12) || 'return t' || CHR(10) || REPEAT(' ', 8) || 't += 1.0 / 12.0' || CHR(10) || REPEAT(' ', 4) || 'return 99.0' || CHR(10) || CHR(10) || CHR(10) || 'def growth_rate(depthpct, prevdepthpct, wt, years_between, default):' || CHR(10) || REPEAT(' ', 4) || '"""Depth growth (mm/y): ILI-to-ILI matched features use their own depth change, others the segment default."""' || CHR(10) || REPEAT(' ', 4) || 'if prevdepthpct is not None and prevdepthpct > 0 and years_between > 0 and depthpct >= prevdepthpct:' || CHR(10) || REPEAT(' ', 8) || 'return (depthpct - prevdepthpct) / 100.0 * wt / years_between' || CHR(10) || REPEAT(' ', 4) || 'return default' || CHR(10) || CHR(10) || CHR(10) || 'def table3_interval(hoop, ratio):' || CHR(10) || REPEAT(' ', 4) || '"""B31.8S Table 3 interval (years) for the hoop stress band and the worst remaining predicted failure' || CHR(10) || REPEAT(' ', 4) || 'pressure ratio. 0 means the ratio is below every row: the features must be remediated first."""' || CHR(10) || REPEAT(' ', 4) || 'for lower, rows in TABLE3:' || CHR(10) || REPEAT(' ', 8) || 'if hoop >= lower:' || CHR(10) || REPEAT(' ', 12) || 'for r, years in rows:' || CHR(10) || REPEAT(' ', 16) || 'if ratio >= r:' || CHR(10) || REPEAT(' ', 20) || 'return years' || CHR(10) || REPEAT(' ', 12) || 'return 0.0' || CHR(10) || REPEAT(' ', 4) || 'return 0.0' || CHR(10) || CHR(10) || CHR(10) || 'def threat_score(susc, mitigated):' || CHR(10) || REPEAT(' ', 4) || 's = SUSC_SCORE.get(susc, 0)' || CHR(10) || REPEAT(' ', 4) || 'if mitigated and s > 1:' || CHR(10) || REPEAT(' ', 8) || 's -= 1' || CHR(10) || REPEAT(' ', 4) || 'return s' || CHR(10) || CHR(10) || CHR(10) || 'def ili_score(n_immediate, n_scheduled, min_life):' || CHR(10) || REPEAT(' ', 4) || '"""Likelihood (1-5) of the metal-loss threats from the ILI results."""' || CHR(10) || REPEAT(' ', 4) || 'if n_immediate:' || CHR(10) || REPEAT(' ', 8) || 'return 5' || CHR(10) || REPEAT(' ', 4) || 'if n_scheduled or min_life < 2.0:' || CHR(10) || REPEAT(' ', 8) || 'return 4' || CHR(10) || REPEAT(' ', 4) || 'if min_life < 5.0:' || CHR(10) || REPEAT(' ', 8) || 'return 3' || CHR(10) || REPEAT(' ', 4) || 'if min_life < 10.0:' || CHR(10) || REPEAT(' ', 8) || 'return 2' || CHR(10) || REPEAT(' ', 4) || 'return 1' || CHR(10) || CHR(10) || CHR(10) || 'def pof_category(scores):' || CHR(10) || REPEAT(' ', 4) || '"""scores: dict threat -> 0..5. PoF category = governing threat, +1 when two or more threats score 3 or' || CHR(10) || REPEAT(' ', 4) || 'more (B31.8S 2.2 interacting threats, e.g. external corrosion with third-party damage). Returns (cat, driver, interacting)."""' || CHR(10) || REPEAT(' ', 4) || 'ranked = sorted(scores.items(), key=lambda kv: (-kv[1], THREATS.index(kv[0]) if kv[0] in THREATS else 99))' || CHR(10) || REPEAT(' ', 4) || 'if not ranked or ranked[0][1] <= 0:' || CHR(10) || REPEAT(' ', 8) || 'return 1, "", []' || CHR(10) || REPEAT(' ', 4) || 'top, driver = ranked[0][1], ranked[0][0]' || CHR(10) || REPEAT(' ', 4) || 'inter = [k for k, v in ranked if v >= 3]' || CHR(10) || REPEAT(' ', 4) || 'cat = min(5, top + (1 if len(inter) >= 2 else 0))' || CHR(10) || REPEAT(' ', 4) || 'return max(cat, 1), driver, inter' || CHR(10) || CHR(10) || CHR(10) || 'def cof_people(buildings, identified_site):' || CHR(10) || REPEAT(' ', 4) || 'if identified_site:' || CHR(10) || REPEAT(' ', 8) || 'return "E"' || CHR(10) || REPEAT(' ', 4) || 'if buildings >= 20:' || CHR(10) || REPEAT(' ', 8) || 'return "D"' || CHR(10) || REPEAT(' ', 4) || 'if buildings >= 10:' || CHR(10) || REPEAT(' ', 8) || 'return "C"' || CHR(10) || REPEAT(' ', 4) || 'if buildings >= 1:' || CHR(10) || REPEAT(' ', 8) || 'return "B"' || CHR(10) || REPEAT(' ', 4) || 'return "A"' || CHR(10) || CHR(10) || CHR(10) || 'def cof_category(value, limits):' || CHR(10) || REPEAT(' ', 4) || 'for i, lim in enumerate(limits):' || CHR(10) || REPEAT(' ', 8) || 'if value <= lim:' || CHR(10) || REPEAT(' ', 12) || 'return "ABCDE"[i]' || CHR(10) || REPEAT(' ', 4) || 'return "E"' || CHR(10) || CHR(10) || CHR(10) || 'def risk_level(pofcat, cofcat):' || CHR(10) || REPEAT(' ', 4) || 'score = pofcat + "ABCDE".index(cofcat) + 1' || CHR(10) || REPEAT(' ', 4) || 'for lim, lvl in RISK_LEVEL:' || CHR(10) || REPEAT(' ', 8) || 'if score <= lim:' || CHR(10) || REPEAT(' ', 12) || 'return lvl' || CHR(10) || REPEAT(' ', 4) || 'return "HIGH"' || CHR(10) || CHR(10) || '# inputs an approved or superseded assessment no longer accepts (generated by gen_pim.py)' || CHR(10) || 'FROZEN_INPUTS = (''ASSETNUM'', ''PIPELINE'', ''KPSTART'', ''KPEND'', ''INSTALLDATE'', ''COATING'', ''ASSESSDATE'', ''ASSESSOR'', ''CLASSLOC'', ''HCA'', ''OD'', ''WT'', ''GRADE'', ''SMYS'', ''MAOP'', ''ILIDATE'', ''ILIREPORTDATE'', ''ILITOOL'', ''PREVILIDATE'', ''DEFAULTCGR'', ''SAFETYF'', ''BUILDINGS'', ''IDSITE'', ''ENVSENS'', ''REPAIRCOST'', ''OUTAGEDAYS'', ''LOSSPERDAY'', ''ENVCOST'', ''MAXINTERVAL'', ''HCAMAX'')' || CHR(10) || 'CHILD_INPUTS = ((''THREATS'', (''THREAT'', ''SUSCEPT'', ''MITIGATED'', ''NOTES'')), (''ANOMALIES'', (''FEATURENUM'', ''KP'', ''CLOCK'', ''FTYPE'', ''SURFACE'', ''DEPTHPCT'', ''LENGTH'', ''WIDTH'', ''DENTPCT'', ''PREVDEPTHPCT'', ''FSTATUS'', ''REPAIRDATE'', ''REPAIRTYPE'')))' || CHR(10) || CHR(10) || CHR(10) || '# ---- Maximo glue: read the assessment, run the model above, write the results ----------------------------' || CHR(10) || '# Runs before every save of PIMASSESS (object launch point) and from Select Action > Recalculate Integrity.' || CHR(10) || 'from psdi.mbo import MboConstants' || CHR(10) || 'from java.util import Date, Calendar' || CHR(10) || CHR(10) || 'F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION' || CHR(10) || 'YEAR_MS = 365.25 * 24 * 3600 * 1000.0' || CHR(10) || 'METHOD = {"EXTCORR": "High-resolution MFL in-line inspection (or ECDA where unpiggable)",' || CHR(10) || REPEAT(' ', 10) || '"INTCORR": "MFL in-line inspection plus ICDA at low points and water drop-out sites",' || CHR(10) || REPEAT(' ', 10) || '"SCC": "EMAT crack-detection ILI or SCCDA digs at susceptible sites",' || CHR(10) || REPEAT(' ', 10) || '"MFG": "Hydrostatic test to 1.25 x MAOP (manufacturing defects)",' || CHR(10) || REPEAT(' ', 10) || '"CONSTR": "Geometry/deformation ILI and girth-weld review",' || CHR(10) || REPEAT(' ', 10) || '"EQUIP": "Station equipment inspection (valves, regulators, relief)",' || CHR(10) || REPEAT(' ', 10) || '"TPD": "Increased patrol, depth-of-cover survey, one-call compliance check",' || CHR(10) || REPEAT(' ', 10) || '"INCOPS": "Procedure review, operator qualification and overpressure protection check",' || CHR(10) || REPEAT(' ', 10) || '"WEATHER": "Geohazard survey and IMU/strain ILI at crossings"}' || CHR(10) || 'FTYPE_TXT = {"METALLOSS": "metal loss", "DENT": "dent", "DENTML": "dent with metal loss", "CRACK": "crack-like"}' || CHR(10) || CHR(10) || CHR(10) || 'def years(d1, d2):' || CHR(10) || REPEAT(' ', 4) || 'return (d2.getTime() - d1.getTime()) / YEAR_MS' || CHR(10) || CHR(10) || CHR(10) || 'def add_years(d, y):' || CHR(10) || REPEAT(' ', 4) || 'cal = Calendar.getInstance()' || CHR(10) || REPEAT(' ', 4) || 'cal.setTime(d)' || CHR(10) || REPEAT(' ', 4) || 'cal.add(Calendar.DAY_OF_YEAR, int(round(y * 365.25)))' || CHR(10) || REPEAT(' ', 4) || 'return cal.getTime()' || CHR(10) || CHR(10) || CHR(10) || 'def setv(o, attr, val):' || CHR(10) || REPEAT(' ', 4) || 'if val is None:' || CHR(10) || REPEAT(' ', 8) || 'o.setValueNull(attr, F)' || CHR(10) || REPEAT(' ', 4) || 'else:' || CHR(10) || REPEAT(' ', 8) || 'o.setValue(attr, val, F)' || CHR(10) || CHR(10) || CHR(10) || '# Approved and superseded assessments are frozen records: the approved basis stays as approved.' || CHR(10) || '_st = mbo.getString("STATUS")' || CHR(10) || '_frozen = _st == "SUPERSEDED" or (_st == "APPR" and not mbo.isModified("STATUS"))' || CHR(10) || 'if _frozen and launchPoint == "PIMCALC":' || CHR(10) || REPEAT(' ', 4) || 'service.error("pim", "frozen")' || CHR(10) || 'if _frozen and not mbo.toBeAdded():' || CHR(10) || REPEAT(' ', 4) || '# integrations write without access checks: refuse changed inputs on a frozen record (the PIM scripts only' || CHR(10) || REPEAT(' ', 4) || '# write work order numbers and the status, which stay allowed)' || CHR(10) || REPEAT(' ', 4) || '_bad = [x for x in FROZEN_INPUTS if mbo.isModified(x)]' || CHR(10) || REPEAT(' ', 4) || 'for _rel, _attrs in CHILD_INPUTS:' || CHR(10) || REPEAT(' ', 8) || '_set = mbo.getMboSet(_rel)' || CHR(10) || REPEAT(' ', 8) || '_r = _set.moveFirst()' || CHR(10) || REPEAT(' ', 8) || 'while _r is not None:' || CHR(10) || REPEAT(' ', 12) || 'if _r.toBeAdded() or _r.toBeDeleted() or [x for x in _attrs if _r.isModified(x)]:' || CHR(10) || REPEAT(' ', 16) || '_bad.append(_rel)' || CHR(10) || REPEAT(' ', 12) || '_r = _set.moveNext()' || CHR(10) || REPEAT(' ', 4) || 'if _bad:' || CHR(10) || REPEAT(' ', 8) || 'service.error("pim", "frozenedit", [mbo.getString("ASSESSNUM")])' || CHR(10) || CHR(10) || CHR(10) || 'def _run():' || CHR(10) || REPEAT(' ', 4) || 'a = mbo' || CHR(10) || REPEAT(' ', 4) || 'if a.isNull("ASSESSDATE"):' || CHR(10) || REPEAT(' ', 8) || 'setv(a, "ASSESSDATE", Date())' || CHR(10) || REPEAT(' ', 4) || 'notes = []' || CHR(10) || REPEAT(' ', 4) || 'cls = a.getString("CLASSLOC") or "1"' || CHR(10) || REPEAT(' ', 4) || 'df = DESIGN_F.get(cls, 0.72)' || CHR(10) || REPEAT(' ', 4) || 'setv(a, "DESIGNF", df)' || CHR(10) || REPEAT(' ', 4) || 'if a.isNull("SAFETYF"):' || CHR(10) || REPEAT(' ', 8) || 'setv(a, "SAFETYF", df)' || CHR(10) || REPEAT(' ', 4) || 'seg = dict(od=a.getDouble("OD"), wt=a.getDouble("WT"), smys=a.getDouble("SMYS"),' || CHR(10) || REPEAT(' ', 15) || 'maop=a.getDouble("MAOP") / 10.0, sf=a.getDouble("SAFETYF") or df)' || CHR(10) || REPEAT(' ', 4) || 'if seg["od"] <= 0 or seg["wt"] <= 0 or seg["smys"] <= 0 or seg["maop"] <= 0:' || CHR(10) || REPEAT(' ', 8) || 'setv(a, "CALCNOTE", "Enter diameter, wall thickness, SMYS and MAOP to calculate the segment.")' || CHR(10) || REPEAT(' ', 8) || 'return' || CHR(10) || REPEAT(' ', 4) || 'ili = a.getDate("ILIDATE")' || CHR(10) || REPEAT(' ', 4) || 'rep = a.getDate("ILIREPORTDATE") or ili' || CHR(10) || REPEAT(' ', 4) || 'prev = a.getDate("PREVILIDATE")' || CHR(10) || REPEAT(' ', 4) || 'between = years(prev, ili) if (prev is not None and ili is not None) else 0.0' || CHR(10) || REPEAT(' ', 4) || 'cgr = a.getDouble("DEFAULTCGR")' || CHR(10) || REPEAT(' ', 4) || 'hoop = hoop_pct(seg["maop"], seg["od"], seg["wt"], seg["smys"])' || CHR(10) || REPEAT(' ', 4) || 'setv(a, "HOOPPCT", round(hoop, 1))' || CHR(10) || REPEAT(' ', 4) || 'setv(a, "PIRM", round(pir(seg["od"], seg["maop"]), 1))' || CHR(10) || CHR(10) || REPEAT(' ', 4) || '# 1. every open anomaly: growth, Modified B31G failure pressure, ERF, B31.8S response, remaining life' || CHR(10) || REPEAT('