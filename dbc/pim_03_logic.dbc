    <freeform description="script PIM.REASSESSWO">
      <sql target="sqlserver"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.REASSESSWO', 'Active', getdate(), getdate(), getdate(), 'MAXADMIN', next value for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: reassessment work order of an approved assessment', '1.0.0', CAST('# PIM.REASSESSWO - the reassessment work order (next ILI run) of an approved assessment.' AS NVARCHAR(MAX)) + CHAR(10) + '# Runs from Select Action > Create Reassessment Work Order and from the PIMDUE escalation.' + CHAR(10) + 'from psdi.mbo import MboConstants' + CHAR(10) + 'F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION' + CHAR(10) + 'a = mbo' + CHAR(10) + '# PIM.LOCK opens approved records read-only, and related sets inherit that flag: lift it on this record so' + CHAR(10) + '# the work order set accepts the new row (the save-time guard in PIM.CALC still refuses changed inputs)' + CHAR(10) + 'a.setFlag(MboConstants.READONLY, False)' + CHAR(10) + 'if a.getString("STATUS") != "APPR":' + CHAR(10) + SPACE(4) + 'service.error("pim", "notapproved")' + CHAR(10) + 'if not a.isNull("WONUM"):' + CHAR(10) + SPACE(4) + 'service.error("pim", "woexists", [a.getString("WONUM")])' + CHAR(10) + 'prio = {"HIGH": 1, "MEDHIGH": 2, "MEDIUM": 3, "LOW": 4}.get(a.getString("RISK"), 3)' + CHAR(10) + 'wos = a.getMboSet("$pimrewo", "WORKORDER", "1=0")' + CHAR(10) + 'wo = wos.add()' + CHAR(10) + 'wo.setValue("SITEID", a.getString("SITEID"), F)' + CHAR(10) + 'wo.setValue("ASSETNUM", a.getString("ASSETNUM"))' + CHAR(10) + 'wo.setValue("WORKTYPE", "INSP")' + CHAR(10) + 'wo.setValue("DESCRIPTION", ("Reassess %s KP %.1f-%.1f: %s" % (a.getString("ASSETNUM"), a.getDouble("KPSTART"),' + CHAR(10) + SPACE(12) + 'a.getDouble("KPEND"), a.getString("ASSESSMETHOD")))[:100])' + CHAR(10) + 'wo.setValue("WOPRIORITY", prio)' + CHAR(10) + 'wo.setValue("TARGSTARTDATE", a.getDate("NEXTASSESSDATE"))' + CHAR(10) + 'wo.setValue("DESCRIPTION_LONGDESCRIPTION",' + CHAR(10) + SPACE(12) + '"Raised by pipeline integrity assessment %s (risk %s %s, governing threat %s).\nInterval set by: %s.\n\n%s"' + CHAR(10) + SPACE(12) + '% (a.getString("ASSESSNUM"), a.getString("RISKCELL"), a.getString("RISK"), a.getString("DRIVER"),' + CHAR(10) + SPACE(15) + 'a.getString("INTERVALBASIS"), a.getString("CALCNOTE")))' + CHAR(10) + 'a.setValue("WONUM", wo.getString("WONUM"), F)' + CHAR(10) where not exists (select 1 from autoscript where autoscript='PIM.REASSESSWO')]]></sql>
