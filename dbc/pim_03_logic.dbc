TAGEDAYS") * a.getDouble("LOSSPERDAY") + a.getDouble("ENVCOST")' || CHR(10) || REPEAT(' ', 4) || 'cf = cof_category(fin, COF_FIN)' || CHR(10) || REPEAT(' ', 4) || 'cof = max(cp, ce, cf)' || CHR(10) || REPEAT(' ', 4) || 'for k, v in (("COFPEOPLE", cp), ("COFENV", ce), ("FINCOST", round(fin, 2)), ("COFFIN", cf), ("COFCAT", cof),' || CHR(10) || REPEAT(' ', 17) || '("RISKCELL", "%d%s" % (pofcat, cof)), ("RISK", risk_level(pofcat, cof))):' || CHR(10) || REPEAT(' ', 8) || 'setv(a, k, v)' || CHR(10) || CHR(10) || REPEAT(' ', 4) || '# 4. reassessment interval: B31.8S Table 3, the maximum interval (HCA or not), half the shortest remaining life' || CHR(10) || REPEAT(' ', 4) || 'tab = table3_interval(hoop, min_ratio) if min_ratio < 99 else (20.0 if hoop < 30 else (15.0 if hoop < 50 else 10.0))' || CHR(10) || REPEAT(' ', 4) || 'setv(a, "TABLEINT", tab)' || CHR(10) || REPEAT(' ', 4) || 'hca = a.getBoolean("HCA")' || CHR(10) || REPEAT(' ', 4) || 'cap = a.getDouble("HCAMAX") if hca else a.getDouble("MAXINTERVAL")' || CHR(10) || REPEAT(' ', 4) || 'cands = [(cap, "%s maximum interval %.0f y" % ("HCA" if hca else "company", cap))]' || CHR(10) || REPEAT(' ', 4) || 'if tab > 0:' || CHR(10) || REPEAT(' ', 8) || 'cands.append((tab, "B31.8S Table 3 (%.0f %% SMYS, Pf/MAOP %.2f)" % (hoop, min_ratio)))' || CHR(10) || REPEAT(' ', 4) || 'else:' || CHR(10) || REPEAT(' ', 8) || 'notes.append("Remaining features are below every B31.8S Table 3 row: remediate before setting an interval.")' || CHR(10) || REPEAT(' ', 4) || 'if min_life < 99:' || CHR(10) || REPEAT(' ', 8) || 'cands.append((min_life / 2.0, "half the shortest remaining life (%.1f y)" % min_life))' || CHR(10) || REPEAT(' ', 4) || 'yrs, why = sorted(cands, key=lambda c: c[0])[0]' || CHR(10) || REPEAT(' ', 4) || 'base = ili or a.getDate("ASSESSDATE")' || CHR(10) || REPEAT(' ', 4) || 'setv(a, "INTERVALBASIS", why[:100])' || CHR(10) || REPEAT(' ', 4) || 'setv(a, "NEXTASSESSDATE", add_years(base, max(yrs, 0.0)))' || CHR(10) || REPEAT(' ', 4) || 'setv(a, "ASSESSMETHOD", METHOD.get(driver, METHOD["EXTCORR"])[:100])' || CHR(10) || CHR(10) || REPEAT(' ', 4) || 'note = ("Segment: OD %.0f mm, wt %.1f mm, SMYS %.0f MPa, MAOP %.1f bar -> hoop %.1f %% SMYS, class %s (F %.2f), "' || CHR(10) || REPEAT(' ', 12) || '"PIR %.0f m. ILI: %d open features (%d immediate, %d scheduled, %d monitored), %d repaired; worst ERF %.3f (%s); "' || CHR(10) || REPEAT(' ', 12) || '"monitored: min Pf/MAOP %s, shortest remaining life %s. Threat scores: %s -> PoF %d (driver %s%s). "' || CHR(10) || REPEAT(' ', 12) || '"CoF people %s, environment %s, cost %.0f USD (%s) -> %s. Risk %d%s %s. Interval %.1f y (%s). %s"' || CHR(10) || REPEAT(' ', 12) || '% (seg["od"], seg["wt"], seg["smys"], seg["maop"] * 10, hoop, cls, df, pir(seg["od"], seg["maop"]), tot,' || CHR(10) || REPEAT(' ', 15) || 'n["IMMEDIATE"], n["SCHEDULED"], n["MONITORED"], n["REPAIRED"], max_erf, worst or "-",' || CHR(10) || REPEAT(' ', 15) || '("%.2f" % min_ratio) if min_ratio < 99 else "-",' || CHR(10) || REPEAT(' ', 15) || '("%.1f y" % min_life) if min_life < 99 else "none within 30 y",' || CHR(10) || REPEAT(' ', 15) || '", ".join("%s %d" % (k, v) for k, v in sorted(scores.items(), key=lambda kv: -kv[1])), pofcat,' || CHR(10) || REPEAT(' ', 15) || 'driver or "-", (", interacting " + "+".join(inter)) if len(inter) >= 2 else "", cp, ce, fin, cf, cof,' || CHR(10) || REPEAT(' ', 15) || 'pofcat, cof, risk_level(pofcat, cof), yrs, why, " ".join(notes)))' || CHR(10) || REPEAT(' ', 4) || 'setv(a, "CALCNOTE", note[:1000])' || CHR(10) || CHR(10) || CHR(10) || 'if not _frozen:' || CHR(10) || REPEAT(' ', 4) || '_run()' || CHR(10) from sysibm.sysdummy1 where not exists (select 1 from autoscript where autoscript='PIM.CALC')]]></sql>
      <sql target="db2"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMCALCSAVE', 'PIM.CALC', 'Recalculate the integrity assessment before every save', 'OBJECT', 'PIMASSESS', 6, null, 1, nextval for scriptlaunchpointseq from sysibm.sysdummy1 where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMCALCSAVE')]]></sql>
      <sql target="db2"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMCALC', 'PIM.CALC', 'Recalculate Integrity', 'ACTION', 'PIMASSESS', null, null, 1, nextval for scriptlaunchpointseq from sysibm.sysdummy1 where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMCALC')]]></sql>
      <sql target="db2"><![CDATA[insert into action (actionid, action, description, objectname, type, value, parameter, langcode, usewith, hasld) select nextval for actionseq, 'PIMCALC', 'Recalculate Integrity', 'PIMASSESS', 'CUSTOM', 'com.ibm.tivoli.maximo.script.ScriptAction', 'PIM.CALC,PIMCALC,PIMCALC', 'EN', 'ALL', 0 from sysibm.sysdummy1 where not exists (select 1 from action where action='PIMCALC')]]></sql>
    </freeform>
    <freeform description="script PIM.CHILDINIT">
      <sql target="sqlserver"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.CHILDINIT', 'Active', getdate(), getdate(), getdate(), 'MAXADMIN', next value for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: new threat and feature rows take the assessment keys', '1.0.0', CAST('# PIM.CHILDINIT - threat and ILI feature rows added on the screen take their keys from the assessment.' AS NVARCHAR(MAX)) + CHAR(10) + 'from psdi.mbo import MboConstants' + CHAR(10) + 'F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION' + CHAR(10) + 'o = mbo.getOwner()' + CHAR(10) + 'if mbo.toBeAdded() and o is not None and o.getName() == "PIMASSESS":' + CHAR(10) + SPACE(4) + 'for k in ("ASSESSNUM", "SITEID", "ORGID"):' + CHAR(10) + SPACE(8) + 'mbo.setValue(k, o.getString(k), F)' + CHAR(10) where not exists (select 1 from autoscript where autoscript='PIM.CHILDINIT')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMTHRINIT', 'PIM.CHILDINIT', 'Copy assessment keys to a new threat row', 'OBJECT', 'PIMTHREAT', 1, null, 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMTHRINIT')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMANOINIT', 'PIM.CHILDINIT', 'Copy assessment keys to a new ILI feature row', 'OBJECT', 'PIMANOM', 1, null, 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMANOINIT')]]></sql>
      <sql target="oracle"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.CHILDINIT', 'Active', sysdate, sysdate, sysdate, 'MAXADMIN', autoscriptseq.nextval, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: new threat and feature rows take the assessment keys', '1.0.0', TO_CLOB('# PIM.CHILDINIT - threat and ILI feature rows added on the screen take their keys from the assessment.') || CHR(10) || TO_CLOB('from psdi.mbo import MboConstants') || CHR(10) || TO_CLOB('F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION') || CHR(10) || TO_CLOB('o = mbo.getOwner()') || CHR(10) || TO_CLOB('if mbo.toBeAdded() and o is not None and o.getName() == "PIMASSESS":') || CHR(10) || RPAD(' ', 4) || TO_CLOB('for k in ("ASSESSNUM", "SITEID", "ORGID"):') || CHR(10) || RPAD(' ', 8) || TO_CLOB('mbo.setValue(k, o.getString(k), F)') || CHR(10) from dual where not exists (select 1 from autoscript where autoscript='PIM.CHILDINIT')]]></sql>
