ORDER", "siteid=:siteid and assetnum=:assetnum and worktype=''DIG'' and "' || CHR(10) || REPEAT(' ', 25) || '"description like ''Dig %s %%'' and status not in (select value from synonymdomain where "' || CHR(10) || REPEAT(' ', 25) || '"domainid=''WOSTATUS'' and maxvalue in (''CAN'',''CLOSE'',''COMP''))" % r.getString("FEATURENUM"))' || CHR(10) || REPEAT(' ', 8) || 'ex.reset()' || CHR(10) || REPEAT(' ', 8) || 'if not ex.isEmpty():' || CHR(10) || REPEAT(' ', 12) || 'r.setValue("WONUM", ex.getMbo(0).getString("WONUM"), F)' || CHR(10) || REPEAT(' ', 12) || 'linked.append(ex.getMbo(0).getString("WONUM"))' || CHR(10) || REPEAT(' ', 12) || 'r = an.moveNext()' || CHR(10) || REPEAT(' ', 12) || 'continue' || CHR(10) || REPEAT(' ', 8) || 'wo = wos.add()' || CHR(10) || REPEAT(' ', 8) || 'wo.setValue("SITEID", a.getString("SITEID"), F)' || CHR(10) || REPEAT(' ', 8) || 'wo.setValue("ASSETNUM", a.getString("ASSETNUM"))' || CHR(10) || REPEAT(' ', 8) || 'wo.setValue("WORKTYPE", "DIG")' || CHR(10) || REPEAT(' ', 8) || 'size = ("%.1f%% OD" % r.getDouble("DENTPCT")) if r.getString("FTYPE") == "DENT" else ("%.0f%% wt" % r.getDouble("DEPTHPCT"))' || CHR(10) || REPEAT(' ', 8) || 'wo.setValue("DESCRIPTION", ("Dig %s KP %.3f: %s %s, %s" % (r.getString("FEATURENUM"), r.getDouble("KP"),' || CHR(10) || REPEAT(' ', 20) || 'TXT.get(r.getString("FTYPE"), r.getString("FTYPE")), size, resp.lower()))[:100])' || CHR(10) || REPEAT(' ', 8) || 'wo.setValue("WOPRIORITY", 1 if resp == "IMMEDIATE" else 2)' || CHR(10) || REPEAT(' ', 8) || 'if not r.isNull("DUEDATE"):' || CHR(10) || REPEAT(' ', 12) || 'wo.setValue("TARGCOMPDATE", r.getDate("DUEDATE"))' || CHR(10) || REPEAT(' ', 12) || 'wo.setValue("TARGSTARTDATE", r.getDate("DUEDATE"))' || CHR(10) || REPEAT(' ', 8) || 'wo.setValue("DESCRIPTION_LONGDESCRIPTION",' || CHR(10) || REPEAT(' ', 20) || '"Raised by pipeline integrity assessment %s.\nFeature %s at KP %.3f, %s o''clock, %s surface.\n"' || CHR(10) || REPEAT(' ', 20) || '"Depth %.1f %% wt, dent %.1f %% OD, length %.0f mm, growth %.3f mm/y.\n%s: Pf %.1f bar, safe pressure "' || CHR(10) || REPEAT(' ', 20) || '"%.1f bar, ERF %.3f, Pf/MAOP %.3f -> B31.8S response %s.%s\n\nExcavate, measure (NDE), "' || CHR(10) || REPEAT(' ', 20) || '"assess and repair; record the repair on the feature (status REPAIRED, repair date, repair type)."' || CHR(10) || REPEAT(' ', 20) || '% (a.getString("ASSESSNUM"), r.getString("FEATURENUM"), r.getDouble("KP"), r.getString("CLOCK"),' || CHR(10) || REPEAT(' ', 23) || 'r.getString("SURFACE"), r.getDouble("DEPTHPCT"), r.getDouble("DENTPCT"), r.getDouble("LENGTH"), r.getDouble("GROWTH"),' || CHR(10) || REPEAT(' ', 23) || '"Modified B31G" if r.getString("FTYPE") in ("METALLOSS", "DENTML") else' || CHR(10) || REPEAT(' ', 23) || '"Intact pipe (response set by the feature type and dent depth)", r.getDouble("PF"), r.getDouble("PSAFE"), r.getDouble("ERF"), r.getDouble("PFRATIO"), resp,' || CHR(10) || REPEAT(' ', 23) || '"\nIMMEDIATE: reduce operating pressure until the repair is complete." if resp == "IMMEDIATE" else ""))' || CHR(10) || REPEAT(' ', 8) || 'r.setValue("WONUM", wo.getString("WONUM"), F)' || CHR(10) || REPEAT(' ', 8) || 'made.append(wo.getString("WONUM"))' || CHR(10) || REPEAT(' ', 4) || 'r = an.moveNext()' || CHR(10) || 'if not made and not linked:' || CHR(10) || REPEAT(' ', 4) || 'service.error("pim", "nodigs")' || CHR(10) from sysibm.sysdummy1 where not exists (select 1 from autoscript where autoscript='PIM.DIGWO')]]></sql>
