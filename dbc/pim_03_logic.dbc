    <freeform description="script PIM.APPROVE">
      <sql target="sqlserver"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.APPROVE', 'Active', getdate(), getdate(), getdate(), 'MAXADMIN', next value for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: supersede older approved assessments of the same segment', '1.0.0', CAST('# PIM.APPROVE - an approved assessment supersedes older approved assessments of the same segment.' AS NVARCHAR(MAX)) + CHAR(10) + 'from psdi.mbo import MboConstants' + CHAR(10) + 'F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION' + CHAR(10) + 'if mbo.getString("STATUS") == "APPR":' + CHAR(10) + SPACE(4) + 'if mbo.isNull("ILIDATE") or mbo.getDouble("MAOP") <= 0 or mbo.getDouble("WT") <= 0:' + CHAR(10) + SPACE(8) + 'service.error("pim", "needili")' + CHAR(10) + SPACE(4) + 'old = mbo.getMboSet("$pimold", "PIMASSESS",' + CHAR(10) + SPACE(24) + '"assetnum=:assetnum and siteid=:siteid and status=''APPR'' and assessnum<>:assessnum")' + CHAR(10) + SPACE(4) + 'o = old.moveFirst()' + CHAR(10) + SPACE(4) + 'while o is not None:' + CHAR(10) + SPACE(8) + 'o.setValue("STATUS", "SUPERSEDED", F)' + CHAR(10) + SPACE(8) + 'o = old.moveNext()' + CHAR(10) where not exists (select 1 from autoscript where autoscript='PIM.APPROVE')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMAPPROVE', 'PIM.APPROVE', 'Supersede older approved assessments', 'OBJECT', 'PIMASSESS', 6, ':status=''APPR''', 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMAPPROVE')]]></sql>
      <sql target="oracle"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.APPROVE', 'Active', sysdate, sysdate, sysdate, 'MAXADMIN', autoscriptseq.nextval, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: supersede older approved assessments of the same segment', '1.0.0', TO_CLOB('# PIM.APPROVE - an approved assessment supersedes older approved assessments of the same segment.') || CHR(10) || TO_CLOB('from psdi.mbo import MboConstants') || CHR(10) || TO_CLOB('F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION') || CHR(10) || TO_CLOB('if mbo.getString("STATUS") == "APPR":') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if mbo.isNull("ILIDATE") or mbo.getDouble("MAOP") <= 0 or mbo.getDouble("WT") <= 0:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('service.error("pim", "needili")') || CHR(10) || RPAD(' ', 4) || TO_CLOB('old = mbo.getMboSet("$pimold", "PIMASSESS",') || CHR(10) || RPAD(' ', 24) || TO_CLOB('"assetnum=:assetnum and siteid=:siteid and status=''APPR'' and assessnum<>:assessnum")') || CHR(10) || RPAD(' ', 4) || TO_CLOB('o = old.moveFirst()') || CHR(10) || RPAD(' ', 4) || TO_CLOB('while o is not None:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('o.setValue("STATUS", "SUPERSEDED", F)') || CHR(10) || RPAD(' ', 8) || TO_CLOB('o = old.moveNext()') || CHR(10) from dual where not exists (select 1 from autoscript where autoscript='PIM.APPROVE')]]></sql>
      <sql target="oracle"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMAPPROVE', 'PIM.APPROVE', 'Supersede older approved assessments', 'OBJECT', 'PIMASSESS', 6, ':status=''APPR''', 1, scriptlaunchpointseq.nextval from dual where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMAPPROVE')]]></sql>
      <sql target="db2"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.APPROVE', 'Active', current timestamp, current timestamp, current timestamp, 'MAXADMIN', nextval for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: supersede older approved assessments of the same segment', '1.0.0', CAST('# PIM.APPROVE - an approved assessment supersedes older approved assessments of the same segment.' AS CLOB) || CHR(10) || 'from psdi.mbo import MboConstants' || CHR(10) || 'F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION' || CHR(10) || 'if mbo.getString("STATUS") == "APPR":' || CHR(10) || REPEAT(' ', 4) || 'if mbo.isNull("ILIDATE") or mbo.getDouble("MAOP") <= 0 or mbo.getDouble("WT") <= 0:' || CHR(10) || REPEAT(' ', 8) || 'service.error("pim", "needili")' || CHR(10) || REPEAT(' ', 4) || 'old = mbo.getMboSet("$pimold", "PIMASSESS",' || CHR(10) || REPEAT(' ', 24) || '"assetnum=:assetnum and siteid=:siteid and status=''APPR'' and assessnum<>:assessnum")' || CHR(10) || REPEAT(' ', 4) || 'o = old.moveFirst()' || CHR(10) || REPEAT(' ', 4) || 'while o is not None:' || CHR(10) || REPEAT(' ', 8) || 'o.setValue("STATUS", "SUPERSEDED", F)' || CHR(10) || REPEAT(' ', 8) || 'o = old.moveNext()' || CHR(10) from sysibm.sysdummy1 where not exists (select 1 from autoscript where autoscript='PIM.APPROVE')]]></sql>
      <sql target="db2"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMAPPROVE', 'PIM.APPROVE', 'Supersede older approved assessments', 'OBJECT', 'PIMASSESS', 6, ':status=''APPR''', 1, nextval for scriptlaunchpointseq from sysibm.sysdummy1 where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMAPPROVE')]]></sql>
