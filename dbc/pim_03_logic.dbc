      <sql target="db2"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.LOCK', 'Active', current timestamp, current timestamp, current timestamp, 'MAXADMIN', nextval for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: approved and superseded assessments open read-only', '1.0.0', CAST('# PIM.LOCK - approved and superseded assessments are frozen records: the assessment, its threats and its' AS CLOB) || CHR(10) || '# ILI features open read-only. The PIM scripts still write their own fields (they bypass access checks).' || CHR(10) || 'from psdi.mbo import MboConstants' || CHR(10) || 'a = mbo if mbo.getName() == "PIMASSESS" else mbo.getOwner()' || CHR(10) || 'if a is not None and a.getName() == "PIMASSESS" and not a.toBeAdded() and' || REPEAT(' ', 9) || 'a.getMboValue("STATUS").getPreviousValue().asString() in ("APPR", "SUPERSEDED"):' || CHR(10) || REPEAT(' ', 4) || 'mbo.setFlag(MboConstants.READONLY, True)' || CHR(10) from sysibm.sysdummy1 where not exists (select 1 from autoscript where autoscript='PIM.LOCK')]]></sql>
