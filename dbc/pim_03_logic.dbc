<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script SYSTEM "script.dtd">
<!--
  Pipeline Integrity Management for Maximo Manage - part 3 of 3: logic.
  Every row is guarded (inserted only if missing): safe to re-run. Restart Manage after install so
  menus, grants and end points are reloaded.
-->
<script author="Mohamed Chihaoui" scriptname="pim_03_logic_1.0.0">
  <description>PIM: calculation, approval, dig and reassessment work orders, due-date escalation</description>
  <statements>
    <freeform description="script PIM.CALC">
      <sql target="sqlserver"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.CALC', 'Active', getdate(), getdate(), getdate(), 'MAXADMIN', next value for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: B31G failure pressure, B31.8S response, threats, consequence, risk and interval', '1.0.0', CAST('# PIM.CALC - pipeline integrity calculation structured after ASME B31.8S and Modified B31G.' AS NVARCHAR(MAX)) + CHAR(10) + '# Pipeline integrity calculation core, structured after ASME B31.8S (integrity management of gas pipelines)' + CHAR(10) + '# and ASME B31G (remaining strength of corroded pipelines, Modified B31G / 0.85dL method).' + CHAR(10) + '# Pure functions only: this text is embedded in the PIM.CALC automation script (Jython 2.7)' + CHAR(10) + '# and imported by the test harness (CPython 3), so keep it compatible with both.' + CHAR(10) + 'import math' + CHAR(10) + CHAR(10) + '# ---- Published formulas and limits ------------------------------------------------------------------------' + CHAR(10) + '# VERIFY against your licensed copies of ASME B31.8S and B31G before production use; keep under change control.' + CHAR(10) + 'FLOW_ADD = 69.0' + SPACE(12) + '# MPa: Modified B31G flow stress = SMYS + 69 MPa (10 ksi)' + CHAR(10) + 'DEPTH_IMMEDIATE = 0.80' + SPACE(5) + '# B31.8S 7.2.1: metal loss deeper than 80 % of wall -> immediate response' + CHAR(10) + 'PF_IMMEDIATE = 1.10' + SPACE(8) + '# B31.8S 7.2.1: predicted failure pressure below 1.1 x MAOP -> immediate response' + CHAR(10) + 'DENT_SCHEDULED = 6.0' + SPACE(7) + '# B31.8S 7.2.2: plain dent deeper than 6 % of the diameter -> scheduled response' + CHAR(10) + 'PIR_K = 0.099' + SPACE(14) + '# B31.8S 3.2 (SI): potential impact radius r = 0.099 * sqrt(d^2 * p), d mm, p MPa -> m' + CHAR(10) + 'DESIGN_F = {"1": 0.72, "2": 0.60, "3": 0.50, "4": 0.40}' + SPACE(3) + '# ASME B31.8 design factor by class location' + CHAR(10) + '# B31.8S Table 3, time-dependent threats, ILI or pressure test: (hoop stress band lower limit in %SMYS,' + CHAR(10) + '# [(minimum predicted failure pressure ratio Pf/MAOP, interval in years), ...] longest interval first)' + CHAR(10) + 'TABLE3 = ((50.0, ((1.39, 10.0), (1.25, 5.0))),' + CHAR(10) + SPACE(10) + '(30.0, ((1.70, 15.0), (1.40, 10.0))),' + CHAR(10) + SPACE(10) + '(0.0, ((2.20, 20.0), (2.00, 15.0), (1.65, 10.0))))' + CHAR(10) + CHAR(10) + '# ---- Company-configurable screening values (relative risk model, B31.8S 5.7 index approach) ---------------' + CHAR(10) + 'SUSC_SCORE = {"HIGH": 4, "MEDIUM": 3, "LOW": 2, "NONE": 0}' + CHAR(10) + 'COF_FIN = (1e4, 1e5, 1e6, 1e7)' + SPACE(10) + '# financial CoF category A..E upper limits (USD), same scale as the RBI module' + CHAR(10) + 'RISK_LEVEL = ((4, "LOW"), (6, "MEDIUM"), (7, "MEDHIGH"), (10, "HIGH"))' + SPACE(3) + '# matrix score = PoF cat + CoF index' + CHAR(10) + 'THREATS = ("EXTCORR", "INTCORR", "SCC", "MFG", "CONSTR", "EQUIP", "TPD", "INCOPS", "WEATHER")' + CHAR(10) + 'ILI_THREATS = ("EXTCORR", "INTCORR")' + SPACE(4) + '# time-dependent metal-loss threats scored from the ILI results' + CHAR(10) + CHAR(10) + CHAR(10) + 'def b31g_mod(od, wt, smys, depth_mm, length_mm):' + CHAR(10) + SPACE(4) + '"""Modified B31G (0.85dL) predicted failure pressure in MPa for one metal-loss feature."""' + CHAR(10) + SPACE(4) + 'if wt <= 0 or od <= 0:' + CHAR(10) + SPACE(8) + 'return 0.0' + CHAR(10) + SPACE(4) + 'dt = min(max(depth_mm / wt, 0.0), 0.999)' + CHAR(10) + SPACE(4) + 'z = length_mm ** 2 / (od * wt)' + CHAR(10) + SPACE(4) + 'if z <= 50.0:' + CHAR(10) + SPACE(8) + 'm = math.sqrt(1.0 + 0.6275 * z - 0.003375 * z * z)' + CHAR(10) + SPACE(4) + 'else:' + CHAR(10) + SPACE(8) + 'm = 0.032 * z + 3.3' + CHAR(10) + SPACE(4) + 'sflow = smys + FLOW_ADD' + CHAR(10) + SPACE(4) + 'sf = sflow * (1.0 - 0.85 * dt) / (1.0 - 0.85 * dt / m)' + CHAR(10) + SPACE(4) + 'return 2.0 * sf * wt / od' + CHAR(10) + CHAR(10) + CHAR(10) + 'def hoop_pct(maop_mpa, od, wt, smys):' + CHAR(10) + SPACE(4) + '"""Hoop stress at MAOP as a percentage of SMYS (Barlow)."""' + CHAR(10) + SPACE(4) + 'return 100.0 * maop_mpa * od / (2.0 * wt * smys)' + CHAR(10) + CHAR(10) + CHAR(10) + 'def pir(od, maop_mpa):' + CHAR(10) + SPACE(4) + '"""Potential impact radius (m)."""' + CHAR(10) + SPACE(4) + 'return PIR_K * math.sqrt(od * od * maop_mpa)' + CHAR(10) + CHAR(10) + CHAR(10) + 'def feature_eval(f, seg, years_since_ili=0.0):' + CHAR(10) + SPACE(4) + '"""Evaluate one anomaly at a time point years_since_ili after the ILI run.' + CHAR(10) + SPACE(4) + 'f: dict(ftype, depthpct, length, dentpct, growth) ; seg: dict(od, wt, smys, maop (MPa), sf)' + CHAR(10) + SPACE(4) + 'Returns dict(depth, pf, psafe, erf, ratio, response)."""' + CHAR(10) + SPACE(4) + 'depth = f["depthpct"] / 100.0 * seg["wt"] + f.get("growth", 0.0) * years_since_ili' + CHAR(10) + SPACE(4) + 'ftype = f["ftype"]' + CHAR(10) + SPACE(4) + 'if ftype in ("METALLOSS", "DENTML"):' + CHAR(10) + SPACE(8) + 'pf = b31g_mod(seg["od"], seg["wt"], seg["smys"], depth, f["length"])' + CHAR(10) + SPACE(4) + 'else:' + SPACE(3) + '# dents and cracks: the pipe body is not thinned; failure pressure of the intact pipe' + CHAR(10) + SPACE(8) + 'pf = 2.0 * (seg["smys"] + FLOW_ADD) * seg["wt"] / seg["od"]' + CHAR(10) + SPACE(4) + 'psafe = pf * seg["sf"]' + CHAR(10) + SPACE(4) + 'erf = seg["maop"] / psafe if psafe > 0 else 99.0' + CHAR(10) + SPACE(4) + 'ratio = pf / seg["maop"] if seg["maop"] > 0 else 99.0' + CHAR(10) + SPACE(4) + 'if ftype in ("DENTML", "CRACK") or depth / seg["wt"] > DEPTH_IMMEDIATE or ratio < PF_IMMEDIATE:' + CHAR(10) + SPACE(8) + 'resp = "IMMEDIATE"' + CHAR(10) + SPACE(4) + 'elif erf >= 1.0 or (ftype == "DENT" and f.get("dentpct", 0.0) > DENT_SCHEDULED):' + CHAR(10) + SPACE(8) + 'resp = "SCHEDULED"' + CHAR(10) + SPACE(4) + 'else:' + CHAR(10) + SPACE(8) + 'resp = "MONITORED"' + CHAR(10) + SPACE(4) + 'return dict(depth=depth, pf=pf, psafe=psafe, erf=erf, ratio=ratio, response=resp)' + CHAR(10) + CHAR(10) + CHAR(10) + 'def remaining_life(f, seg, horizon=30.0):' + CHAR(10) + SPACE(4) + '"""Years from the ILI run until a monitored metal-loss feature needs repair (ERF reaches 1 or it turns' + CHAR(10) + SPACE(4) + 'immediate), with its depth growing at f[''growth''] mm/y. 99 when it never does within the horizon."""' + CHAR(10) + SPACE(4) + 'if f["ftype"] != "METALLOSS" or f.get("growth", 0.0) <= 0:' + CHAR(10) + SPACE(8) + 'return 99.0' + CHAR(10) + SPACE(4) + 't = 0.0' + CHAR(10) + SPACE(4) + 'while t <= horizon:' + CHAR(10) + SPACE(8) + 'if feature_eval(f, seg, t)["response"] != "MONITORED":' + CHAR(10) + SPACE(12) + 'return t' + CHAR(10) + SPACE(8) + 't += 1.0 / 12.0' + CHAR(10) + SPACE(4) + 'return 99.0' + CHAR(10) + CHAR(10) + CHAR(10) + 'def growth_rate(depthpct, prevdepthpct, wt, years_between, default):' + CHAR(10) + SPACE(4) + '"""Depth growth (mm/y): ILI-to-ILI matched features use their own depth change, others the segment default."""' + CHAR(10) + SPACE(4) + 'if prevdepthpct is not None and prevdepthpct > 0 and years_between > 0 and depthpct >= prevdepthpct:' + CHAR(10) + SPACE(8) + 'return (depthpct - prevdepthpct) / 100.0 * wt / years_between' + CHAR(10) + SPACE(4) + 'return default' + CHAR(10) + CHAR(10) + CHAR(10) + 'def table3_interval(hoop, ratio):' + CHAR(10) + SPACE(4) + '"""B31.8S Table 3 interval (years) for the hoop stress band and the worst remaining predicted failure' + CHAR(10) + SPACE(4) + 'pressure ratio. 0 means the ratio is below every row: the features must be remediated first."""' + CHAR(10) + SPACE(4) + 'for lower, rows in TABLE3:' + CHAR(10) + SPACE(8) + 'if hoop >= lower:' + CHAR(10) + SPACE(12) + 'for r, years in rows:' + CHAR(10) + SPACE(16) + 'if ratio >= r:' + CHAR(10) + SPACE(20) + 'return years' + CHAR(10) + SPACE(12) + 'return 0.0' + CHAR(10) + SPACE(4) + 'return 0.0' + CHAR(10) + CHAR(10) + CHAR(10) + 'def threat_score(susc, mitigated):' + CHAR(10) + SPACE(4) + 's = SUSC_SCORE.get(susc, 0)' + CHAR(10) + SPACE(4) + 'if mitigated and s > 1:' + CHAR(10) + SPACE(8) + 's -= 1' + CHAR(10) + SPACE(4) + 'return s' + CHAR(10) + CHAR(10) + CHAR(10) + 'def ili_score(n_immediate, n_scheduled, min_life):' + CHAR(10) + SPACE(4) + '"""Likelihood (1-5) of the metal-loss threats from the ILI results."""' + CHAR(10) + SPACE(4) + 'if n_immediate:' + CHAR(10) + SPACE(8) + 'return 5' + CHAR(10) + SPACE(4) + 'if n_scheduled or min_life < 2.0:' + CHAR(10) + SPACE(8) + 'return 4' + CHAR(10) + SPACE(4) + 'if min_life < 5.0:' + CHAR(10) + SPACE(8) + 'return 3' + CHAR(10) + SPACE(4) + 'if min_life < 10.0:' + CHAR(10) + SPACE(8) + 'return 2' + CHAR(10) + SPACE(4) + 'return 1' + CHAR(10) + CHAR(10) + CHAR(10) + 'def pof_category(scores):' + CHAR(10) + SPACE(4) + '"""scores: dict threat -> 0..5. PoF category = governing threat, +1 when two or more threats score 3 or' + CHAR(10) + SPACE(4) + 'more (B31.8S 2.2 interacting threats, e.g. external corrosion with third-party damage). Returns (cat, driver, interacting)."""' + CHAR(10) + SPACE(4) + 'ranked = sorted(scores.items(), key=lambda kv: (-kv[1], THREATS.index(kv[0]) if kv[0] in THREATS else 99))' + CHAR(10) + SPACE(4) + 'if not ranked or ranked[0][1] <= 0:' + CHAR(10) + SPACE(8) + 'return 1, "", []' + CHAR(10) + SPACE(4) + 'top, driver = ranked[0][1], ranked[0][0]' + CHAR(10) + SPACE(4) + 'inter = [k for k, v in ranked if v >= 3]' + CHAR(10) + SPACE(4) + 'cat = min(5, top + (1 if len(inter) >= 2 else 0))' + CHAR(10) + SPACE(4) + 'return max(cat, 1), driver, inter' + CHAR(10) + CHAR(10) + CHAR(10) + 'def cof_people(buildings, identified_site):' + CHAR(10) + SPACE(4) + 'if identified_site:' + CHAR(10) + SPACE(8) + 'return "E"' + CHAR(10) + SPACE(4) + 'if buildings >= 20:' + CHAR(10) + SPACE(8) + 'return "D"' + CHAR(10) + SPACE(4) + 'if buildings >= 10:' + CHAR(10) + SPACE(8) + 'return "C"' + CHAR(10) + SPACE(4) + 'if buildings >= 1:' + CHAR(10) + SPACE(8) + 'return "B"' + CHAR(10) + SPACE(4) + 'return "A"' + CHAR(10) + CHAR(10) + CHAR(10) + 'def cof_category(value, limits):' + CHAR(10) + SPACE(4) + 'for i, lim in enumerate(limits):' + CHAR(10) + SPACE(8) + 'if value <= lim:' + CHAR(10) + SPACE(12) + 'return "ABCDE"[i]' + CHAR(10) + SPACE(4) + 'return "E"' + CHAR(10) + CHAR(10) + CHAR(10) + 'def risk_level(pofcat, cofcat):' + CHAR(10) + SPACE(4) + 'score = pofcat + "ABCDE".index(cofcat) + 1' + CHAR(10) + SPACE(4) + 'for lim, lvl in RISK_LEVEL:' + CHAR(10) + SPACE(8) + 'if score <= lim:' + CHAR(10) + SPACE(12) + 'return lvl' + CHAR(10) + SPACE(4) + 'return "HIGH"' + CHAR(10) + CHAR(10) + '# inputs an approved or superseded assessment no longer accepts (generated by gen_pim.py)' + CHAR(10) + 'FROZEN_INPUTS = (''ASSETNUM'', ''PIPELINE'', ''KPSTART'', ''KPEND'', ''INSTALLDATE'', ''COATING'', ''ASSESSDATE'', ''ASSESSOR'', ''CLASSLOC'', ''HCA'', ''OD'', ''WT'', ''GRADE'', ''SMYS'', ''MAOP'', ''ILIDATE'', ''ILIREPORTDATE'', ''ILITOOL'', ''PREVILIDATE'', ''DEFAULTCGR'', ''SAFETYF'', ''BUILDINGS'', ''IDSITE'', ''ENVSENS'', ''REPAIRCOST'', ''OUTAGEDAYS'', ''LOSSPERDAY'', ''ENVCOST'', ''MAXINTERVAL'', ''HCAMAX'')' + CHAR(10) + 'CHILD_INPUTS = ((''THREATS'', (''THREAT'', ''SUSCEPT'', ''MITIGATED'', ''NOTES'')), (''ANOMALIES'', (''FEATURENUM'', ''KP'', ''CLOCK'', ''FTYPE'', ''SURFACE'', ''DEPTHPCT'', ''LENGTH'', ''WIDTH'', ''DENTPCT'', ''PREVDEPTHPCT'', ''FSTATUS'', ''REPAIRDATE'', ''REPAIRTYPE'')))' + CHAR(10) + CHAR(10) + CHAR(10) + '# ---- Maximo glue: read the assessment, run the model above, write the results ----------------------------' + CHAR(10) + '# Runs before every save of PIMASSESS (object launch point) and from Select Action > Recalculate Integrity.' + CHAR(10) + 'from psdi.mbo import MboConstants' + CHAR(10) + 'from java.util import Date, Calendar' + CHAR(10) + CHAR(10) + 'F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION' + CHAR(10) + 'YEAR_MS = 365.25 * 24 * 3600 * 1000.0' + CHAR(10) + 'METHOD = {"EXTCORR": "High-resolution MFL in-line inspection (or ECDA where unpiggable)",' + CHAR(10) + SPACE(10) + '"INTCORR": "MFL in-line inspection plus ICDA at low points and water drop-out sites",' + CHAR(10) + SPACE(10) + '"SCC": "EMAT crack-detection ILI or SCCDA digs at susceptible sites",' + CHAR(10) + SPACE(10) + '"MFG": "Hydrostatic test to 1.25 x MAOP (manufacturing defects)",' + CHAR(10) + SPACE(10) + '"CONSTR": "Geometry/deformation ILI and girth-weld review",' + CHAR(10) + SPACE(10) + '"EQUIP": "Station equipment inspection (valves, regulators, relief)",' + CHAR(10) + SPACE(10) + '"TPD": "Increased patrol, depth-of-cover survey, one-call compliance check",' + CHAR(10) + SPACE(10) + '"INCOPS": "Procedure review, operator qualification and overpressure protection check",' + CHAR(10) + SPACE(10) + '"WEATHER": "Geohazard survey and IMU/strain ILI at crossings"}' + CHAR(10) + 'FTYPE_TXT = {"METALLOSS": "metal loss", "DENT": "dent", "DENTML": "dent with metal loss", "CRACK": "crack-like"}' + CHAR(10) + CHAR(10) + CHAR(10) + 'def years(d1, d2):' + CHAR(10) + SPACE(4) + 'return (d2.getTime() - d1.getTime()) / YEAR_MS' + CHAR(10) + CHAR(10) + CHAR(10) + 'def add_years(d, y):' + CHAR(10) + SPACE(4) + 'cal = Calendar.getInstance()' + CHAR(10) + SPACE(4) + 'cal.setTime(d)' + CHAR(10) + SPACE(4) + 'cal.add(Calendar.DAY_OF_YEAR, int(round(y * 365.25)))' + CHAR(10) + SPACE(4) + 'return cal.getTime()' + CHAR(10) + CHAR(10) + CHAR(10) + 'def setv(o, attr, val):' + CHAR(10) + SPACE(4) + 'if val is None:' + CHAR(10) + SPACE(8) + 'o.setValueNull(attr, F)' + CHAR(10) + SPACE(4) + 'else:' + CHAR(10) + SPACE(8) + 'o.setValue(attr, val, F)' + CHAR(10) + CHAR(10) + CHAR(10) + '# Approved and superseded assessments are frozen records: the approved basis stays as approved.' + CHAR(10) + '_st = mbo.getString("STATUS")' + CHAR(10) + '_frozen = _st == "SUPERSEDED" or (_st == "APPR" and not mbo.isModified("STATUS"))' + CHAR(10) + 'if _frozen and launchPoint == "PIMCALC":' + CHAR(10) + SPACE(4) + 'service.error("pim", "frozen")' + CHAR(10) + 'if _frozen and not mbo.toBeAdded():' + CHAR(10) + SPACE(4) + '# integrations write without access checks: refuse changed inputs on a frozen record (the PIM scripts only' + CHAR(10) + SPACE(4) + '# write work order numbers and the status, which stay allowed)' + CHAR(10) + SPACE(4) + '_bad = [x for x in FROZEN_INPUTS if mbo.isModified(x)]' + CHAR(10) + SPACE(4) + 'for _rel, _attrs in CHILD_INPUTS:' + CHAR(10) + SPACE(8) + '_set = mbo.getMboSet(_rel)' + CHAR(10) + SPACE(8) + '_r = _set.moveFirst()' + CHAR(10) + SPACE(8) + 'while _r is not None:' + CHAR(10) + SPACE(12) + 'if _r.toBeAdded() or _r.toBeDeleted() or [x for x in _attrs if _r.isModified(x)]:' + CHAR(10) + SPACE(16) + '_bad.append(_rel)' + CHAR(10) + SPACE(12) + '_r = _set.moveNext()' + CHAR(10) + SPACE(4) + 'if _bad:' + CHAR(10) + SPACE(8) + 'service.error("pim", "frozenedit", [mbo.getString("ASSESSNUM")])' + CHAR(10) + CHAR(10) + CHAR(10) + 'def _run():' + CHAR(10) + SPACE(4) + 'a = mbo' + CHAR(10) + SPACE(4) + 'if a.isNull("ASSESSDATE"):' + CHAR(10) + SPACE(8) + 'setv(a, "ASSESSDATE", Date())' + CHAR(10) + SPACE(4) + 'notes = []' + CHAR(10) + SPACE(4) + 'cls = a.getString("CLASSLOC") or "1"' + CHAR(10) + SPACE(4) + 'df = DESIGN_F.get(cls, 0.72)' + CHAR(10) + SPACE(4) + 'setv(a, "DESIGNF", df)' + CHAR(10) + SPACE(4) + 'if a.isNull("SAFETYF"):' + CHAR(10) + SPACE(8) + 'setv(a, "SAFETYF", df)' + CHAR(10) + SPACE(4) + 'seg = dict(od=a.getDouble("OD"), wt=a.getDouble("WT"), smys=a.getDouble("SMYS"),' + CHAR(10) + SPACE(15) + 'maop=a.getDouble("MAOP") / 10.0, sf=a.getDouble("SAFETYF") or df)' + CHAR(10) + SPACE(4) + 'if seg["od"] <= 0 or seg["wt"] <= 0 or seg["smys"] <= 0 or seg["maop"] <= 0:' + CHAR(10) + SPACE(8) + 'setv(a, "CALCNOTE", "Enter diameter, wall thickness, SMYS and MAOP to calculate the segment.")' + CHAR(10) + SPACE(8) + 'return' + CHAR(10) + SPACE(4) + 'ili = a.getDate("ILIDATE")' + CHAR(10) + SPACE(4) + 'rep = a.getDate("ILIREPORTDATE") or ili' + CHAR(10) + SPACE(4) + 'prev = a.getDate("PREVILIDATE")' + CHAR(10) + SPACE(4) + 'between = years(prev, ili) if (prev is not None and ili is not None) else 0.0' + CHAR(10) + SPACE(4) + 'cgr = a.getDouble("DEFAULTCGR")' + CHAR(10) + SPACE(4) + 'hoop = hoop_pct(seg["maop"], seg["od"], seg["wt"], seg["smys"])' + CHAR(10) + SPACE(4) + 'setv(a, "HOOPPCT", round(hoop, 1))' + CHAR(10) + SPACE(4) + 'setv(a, "PIRM", round(pir(seg["od"], seg["maop"]), 1))' + CHAR(10) + CHAR(10) + SPACE(4) + '# 1. every open anomaly: growth, Modified B31G failure pressure, ERF, B31.8S response, remaining life' + CHAR(10) + SPACE(4) + 'n = dict(IMMEDIATE=0, SCHEDULED=0, MONITORED=0, REPAIRED=0)' + CHAR(10) + SPACE(4) + 'surf = dict((k, dict(n=0, i=0, s=0, life=99.0)) for k in ("EXT", "INT", "TPD", "SCC"))' + CHAR(10) + SPACE(4) + 'max_erf, min_ratio, min_life, worst = 0.0, 99.0, 99.0, ""' + CHAR(10) + SPACE(4) + 'an = a.getMboSet("ANOMALIES")' + CHAR(10) + SPACE(4) + 'r = an.moveFirst()' + CHAR(10) + SPACE(4) + 'while r is not None:' + CHAR(10) + SPACE(8) + 'if r.toBeDeleted():' + CHAR(10) + SPACE(12) + 'r = an.moveNext()' + CHAR(10) + SPACE(12) + 'continue' + CHAR(10) + SPACE(8) + 'if r.getString("FSTATUS") == "REPAIRED":' + CHAR(10) + SPACE(12) + 'n["REPAIRED"] += 1' + CHAR(10) + SPACE(12) + 'setv(r, "RESPONSE", "REPAIRED")' + CHAR(10) + SPACE(12) + 'for k in ("REMLIFE", "DUEDATE"):' + CHAR(10) + SPACE(16) + 'setv(r, k, None)' + CHAR(10) + SPACE(12) + 'r = an.moveNext()' + CHAR(10) + SPACE(12) + 'continue' + CHAR(10) + SPACE(8) + 'ftype = r.getString("FTYPE") or "METALLOSS"' + CHAR(10) + SPACE(8) + 'g = 0.0 if ftype in ("DENT", "CRACK") else growth_rate(' + CHAR(10) + SPACE(12) + 'r.getDouble("DEPTHPCT"), None if r.isNull("PREVDEPTHPCT") else r.getDouble("PREVDEPTHPCT"),' + CHAR(10) + SPACE(12) + 'seg["wt"], between, cgr)' + CHAR(10) + SPACE(8) + 'f = dict(ftype=ftype, depthpct=r.getDouble("DEPTHPCT"),' + CHAR(10) + SPACE(17) + 'length=r.getDouble("LENGTH"), dentpct=r.getDouble("DENTPCT"), growth=g)' + CHAR(10) + SPACE(8) + 'e = feature_eval(f, seg, 0.0)' + CHAR(10) + SPACE(8) + 'life = remaining_life(f, seg) if e["response"] == "MONITORED" else 0.0' + CHAR(10) + SPACE(8) + 'resp = e["response"]' + CHAR(10) + SPACE(8) + 'n[resp] += 1' + CHAR(10) + SPACE(8) + '# metal loss scores the corrosion threat of its surface; dents score mechanical damage, cracks SCC' + CHAR(10) + SPACE(8) + 'ft = f["ftype"]' + CHAR(10) + SPACE(8) + 'key = {"DENT": "TPD", "CRACK": "SCC"}.get(ft) or ("INT" if r.getString("SURFACE") == "INT" else "EXT")' + CHAR(10) + SPACE(8) + 'if ft == "DENTML":' + CHAR(10) + SPACE(12) + 'mech = surf["TPD"]' + CHAR(10) + SPACE(12) + 'mech["n"] += 1' + CHAR(10) + SPACE(12) + 'mech["i"] += resp == "IMMEDIATE"' + CHAR(10) + SPACE(8) + 'sk = surf[key]' + CHAR(10) + SPACE(8) + 'sk["n"] += 1' + CHAR(10) + SPACE(8) + 'if sk is not None:' + CHAR(10) + SPACE(12) + 'sk["i"] += resp == "IMMEDIATE"' + CHAR(10) + SPACE(12) + 'sk["s"] += resp == "SCHEDULED"' + CHAR(10) + SPACE(12) + 'if resp == "MONITORED":' + CHAR(10) + SPACE(16) + 'sk["life"] = min(sk["life"], life)' + CHAR(10) + SPACE(8) + 'if e["erf"] > max_erf:' + CHAR(10) + SPACE(12) + 'max_erf, worst = e["erf"], r.getString("FEATURENUM")' + CHAR(10) + SPACE(8) + 'if resp == "MONITORED":' + CHAR(10) + SPACE(12) + 'min_ratio = min(min_ratio, e["ratio"])' + CHAR(10) + SPACE(12) + 'min_life = min(min_life, life)' + CHAR(10) + SPACE(8) + 'if resp == "IMMEDIATE":' + CHAR(10) + SPACE(12) + 'due = rep' + CHAR(10) + SPACE(8) + 'elif resp == "SCHEDULED":' + CHAR(10) + SPACE(12) + 'due = add_years(rep, 1.0) if rep is not None else None' + CHAR(10) + SPACE(8) + 'else:' + CHAR(10) + SPACE(12) + 'due = add_years(ili, life) if (ili is not None and life < 99.0) else None' + CHAR(10) + SPACE(8) + 'for k, v in (("GROWTH", round(g, 3)), ("PF", round(e["pf"] * 10.0, 1)), ("PSAFE", round(e["psafe"] * 10.0, 1)),' + CHAR(10) + SPACE(21) + '("ERF", round(e["erf"], 3)), ("PFRATIO", round(e["ratio"], 3)), ("RESPONSE", resp),' + CHAR(10) + SPACE(21) + '("REMLIFE", round(life, 1) if life < 99.0 else None), ("DUEDATE", due)):' + CHAR(10) + SPACE(12) + 'setv(r, k, v)' + CHAR(10) + SPACE(8) + 'r = an.moveNext()' + CHAR(10) + SPACE(4) + 'tot = n["IMMEDIATE"] + n["SCHEDULED"] + n["MONITORED"]' + CHAR(10) + SPACE(4) + 'for k, v in (("NUMANOM", tot + n["REPAIRED"]), ("NUMIMMED", n["IMMEDIATE"]), ("NUMSCHED", n["SCHEDULED"]),' + CHAR(10) + SPACE(17) + '("NUMMON", n["MONITORED"]), ("NUMREPAIRED", n["REPAIRED"]), ("MAXERF", round(max_erf, 3)),' + CHAR(10) + SPACE(17) + '("MINPFRATIO", round(min_ratio, 3) if min_ratio < 99 else None),' + CHAR(10) + SPACE(17) + '("MINLIFE", round(min_life, 1) if min_life < 99.0 else None)):' + CHAR(10) + SPACE(8) + 'setv(a, k, v)' + CHAR(10) + SPACE(4) + 'if ili is None or not (tot + n["REPAIRED"]):' + CHAR(10) + SPACE(8) + 'notes.append("No ILI feature listing yet: corrosion threats scored from susceptibility only.")' + CHAR(10) + CHAR(10) + SPACE(4) + '# 2. threats: ILI metal loss scores the corrosion threats (measured condition replaces assumed susceptibility,' + CHAR(10) + SPACE(4) + '#' + SPACE(4) + 'at least 2 while open features are growing); ILI dents and cracks raise mechanical damage and SCC' + CHAR(10) + SPACE(4) + 'ILI_KEY = {"EXTCORR": "EXT", "INTCORR": "INT", "TPD": "TPD", "SCC": "SCC"}' + CHAR(10) + CHAR(10) + SPACE(4) + 'listed = ili is not None and (tot + n["REPAIRED"]) > 0' + SPACE(3) + '# an ILI listing has been loaded' + CHAR(10) + CHAR(10) + SPACE(4) + 'def measured(k):' + CHAR(10) + SPACE(8) + 'sv = surf[ILI_KEY[k]]' + CHAR(10) + SPACE(8) + 'if not listed or not sv["n"]:' + CHAR(10) + SPACE(12) + 'return None' + CHAR(10) + SPACE(8) + 'return max(ili_score(sv["i"], sv["s"], sv["life"]), 2)' + CHAR(10) + CHAR(10) + SPACE(4) + 'scores, rows = {}, []' + CHAR(10) + SPACE(4) + 'th = a.getMboSet("THREATS")' + CHAR(10) + SPACE(4) + 't = th.moveFirst()' + CHAR(10) + SPACE(4) + 'while t is not None:' + CHAR(10) + SPACE(8) + 'if not t.toBeDeleted():' + CHAR(10) + SPACE(12) + 'k = t.getString("THREAT")' + CHAR(10) + SPACE(12) + 's = threat_score(t.getString("SUSCEPT"), t.getBoolean("MITIGATED"))' + CHAR(10) + SPACE(12) + 'm = measured(k) if k in ILI_KEY else None' + CHAR(10) + SPACE(12) + 'if m is not None:' + CHAR(10) + SPACE(16) + 's = m if k in ILI_THREATS else max(s, m)' + CHAR(10) + SPACE(12) + 'elif k in ILI_THREATS and listed:' + CHAR(10) + SPACE(16) + 's = 1' + SPACE(3) + '# ILI ran and found no metal loss on that surface' + CHAR(10) + SPACE(12) + 'scores[k] = max(scores.get(k, 0), s)' + CHAR(10) + SPACE(12) + 'setv(t, "SCORE", s)' + CHAR(10) + SPACE(12) + 'setv(t, "RECMETHOD", METHOD.get(k, "")[:100])' + CHAR(10) + SPACE(12) + 'rows.append(t)' + CHAR(10) + SPACE(8) + 't = th.moveNext()' + CHAR(10) + SPACE(4) + 'for k in ILI_KEY:' + SPACE(3) + '# ILI findings count even when nobody listed that threat' + CHAR(10) + SPACE(8) + 'm = measured(k)' + CHAR(10) + SPACE(8) + 'if k not in scores and m is not None:' + CHAR(10) + SPACE(12) + 'scores[k] = m' + CHAR(10) + SPACE(12) + 'notes.append("ILI findings scored %s %d (no threat row)." % (k, m))' + CHAR(10) + SPACE(4) + 'pofcat, driver, inter = pof_category(scores)' + CHAR(10) + SPACE(4) + 'setv(a, "POFCAT", pofcat)' + CHAR(10) + SPACE(4) + 'setv(a, "DRIVER", driver or None)' + CHAR(10) + SPACE(4) + 'setv(a, "INTERACT", ", ".join(inter) if len(inter) >= 2 else None)' + CHAR(10) + CHAR(10) + SPACE(4) + '# 3. consequence: people inside the potential impact radius, environment, cost' + CHAR(10) + SPACE(4) + 'cp = cof_people(a.getInt("BUILDINGS"), a.getBoolean("IDSITE"))' + CHAR(10) + SPACE(4) + 'ce = {"HIGH": "D", "MEDIUM": "C"}.get(a.getString("ENVSENS"), "A")' + CHAR(10) + SPACE(4) + 'fin = a.getDouble("REPAIRCOST") + a.getDouble("OUTAGEDAYS") * a.getDouble("LOSSPERDAY") + a.getDouble("ENVCOST")' + CHAR(10) + SPACE(4) + 'cf = cof_category(fin, COF_FIN)' + CHAR(10) + SPACE(4) + 'cof = max(cp, ce, cf)' + CHAR(10) + SPACE(4) + 'for k, v in (("COFPEOPLE", cp), ("COFENV", ce), ("FINCOST", round(fin, 2)), ("COFFIN", cf), ("COFCAT", cof),' + CHAR(10) + SPACE(17) + '("RISKCELL", "%d%s" % (pofcat, cof)), ("RISK", risk_level(pofcat, cof))):' + CHAR(10) + SPACE(8) + 'setv(a, k, v)' + CHAR(10) + CHAR(10) + SPACE(4) + '# 4. reassessment interval: B31.8S Table 3, the maximum interval (HCA or not), half the shortest remaining life' + CHAR(10) + SPACE(4) + 'tab = table3_interval(hoop, min_ratio) if min_ratio < 99 else (20.0 if hoop < 30 else (15.0 if hoop < 50 else 10.0))' + CHAR(10) + SPACE(4) + 'setv(a, "TABLEINT", tab)' + CHAR(10) + SPACE(4) + 'hca = a.getBoolean("HCA")' + CHAR(10) + SPACE(4) + 'cap = a.getDouble("HCAMAX") if hca else a.getDouble("MAXINTERVAL")' + CHAR(10) + SPACE(4) + 'cands = [(cap, "%s maximum interval %.0f y" % ("HCA" if hca else "company", cap))]' + CHAR(10) + SPACE(4) + 'if tab > 0:' + CHAR(10) + SPACE(8) + 'cands.append((tab, "B31.8S Table 3 (%.0f %% SMYS, Pf/MAOP %.2f)" % (hoop, min_ratio)))' + CHAR(10) + SPACE(4) + 'else:' + CHAR(10) + SPACE(8) + 'notes.append("Remaining features are below every B31.8S Table 3 row: remediate before setting an interval.")' + CHAR(10) + SPACE(4) + 'if min_life < 99:' + CHAR(10) + SPACE(8) + 'cands.append((min_life / 2.0, "half the shortest remaining life (%.1f y)" % min_life))' + CHAR(10) + SPACE(4) + 'yrs, why = sorted(cands, key=lambda c: c[0])[0]' + CHAR(10) + SPACE(4) + 'base = ili or a.getDate("ASSESSDATE")' + CHAR(10) + SPACE(4) + 'setv(a, "INTERVALBASIS", why[:100])' + CHAR(10) + SPACE(4) + 'setv(a, "NEXTASSESSDATE", add_years(base, max(yrs, 0.0)))' + CHAR(10) + SPACE(4) + 'setv(a, "ASSESSMETHOD", METHOD.get(driver, METHOD["EXTCORR"])[:100])' + CHAR(10) + CHAR(10) + SPACE(4) + 'note = ("Segment: OD %.0f mm, wt %.1f mm, SMYS %.0f MPa, MAOP %.1f bar -> hoop %.1f %% SMYS, class %s (F %.2f), "' + CHAR(10) + SPACE(12) + '"PIR %.0f m. ILI: %d open features (%d immediate, %d scheduled, %d monitored), %d repaired; worst ERF %.3f (%s); "' + CHAR(10) + SPACE(12) + '"monitored: min Pf/MAOP %s, shortest remaining life %s. Threat scores: %s -> PoF %d (driver %s%s). "' + CHAR(10) + SPACE(12) + '"CoF people %s, environment %s, cost %.0f USD (%s) -> %s. Risk %d%s %s. Interval %.1f y (%s). %s"' + CHAR(10) + SPACE(12) + '% (seg["od"], seg["wt"], seg["smys"], seg["maop"] * 10, hoop, cls, df, pir(seg["od"], seg["maop"]), tot,' + CHAR(10) + SPACE(15) + 'n["IMMEDIATE"], n["SCHEDULED"], n["MONITORED"], n["REPAIRED"], max_erf, worst or "-",' + CHAR(10) + SPACE(15) + '("%.2f" % min_ratio) if min_ratio < 99 else "-",' + CHAR(10) + SPACE(15) + '("%.1f y" % min_life) if min_life < 99 else "none within 30 y",' + CHAR(10) + SPACE(15) + '", ".join("%s %d" % (k, v) for k, v in sorted(scores.items(), key=lambda kv: -kv[1])), pofcat,' + CHAR(10) + SPACE(15) + 'driver or "-", (", interacting " + "+".join(inter)) if len(inter) >= 2 else "", cp, ce, fin, cf, cof,' + CHAR(10) + SPACE(15) + 'pofcat, cof, risk_level(pofcat, cof), yrs, why, " ".join(notes)))' + CHAR(10) + SPACE(4) + 'setv(a, "CALCNOTE", note[:1000])' + CHAR(10) + CHAR(10) + CHAR(10) + 'if not _frozen:' + CHAR(10) + SPACE(4) + '_run()' + CHAR(10) where not exists (select 1 from autoscript where autoscript='PIM.CALC')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMCALCSAVE', 'PIM.CALC', 'Recalculate the integrity assessment before every save', 'OBJECT', 'PIMASSESS', 6, null, 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMCALCSAVE')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMCALC', 'PIM.CALC', 'Recalculate Integrity', 'ACTION', 'PIMASSESS', null, null, 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMCALC')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into action (actionid, action, description, objectname, type, value, parameter, langcode, usewith, hasld) select next value for actionseq, 'PIMCALC', 'Recalculate Integrity', 'PIMASSESS', 'CUSTOM', 'com.ibm.tivoli.maximo.script.ScriptAction', 'PIM.CALC,PIMCALC,PIMCALC', 'EN', 'ALL', 0 where not exists (select 1 from action where action='PIMCALC')]]></sql>
      <sql target="oracle"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.CALC', 'Active', sysdate, sysdate, sysdate, 'MAXADMIN', autoscriptseq.nextval, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: B31G failure pressure, B31.8S response, threats, consequence, risk and interval', '1.0.0', TO_CLOB('# PIM.CALC - pipeline integrity calculation structured after ASME B31.8S and Modified B31G.') || CHR(10) || TO_CLOB('# Pipeline integrity calculation core, structured after ASME B31.8S (integrity management of gas pipelines)') || CHR(10) || TO_CLOB('# and ASME B31G (remaining strength of corroded pipelines, Modified B31G / 0.85dL method).') || CHR(10) || TO_CLOB('# Pure functions only: this text is embedded in the PIM.CALC automation script (Jython 2.7)') || CHR(10) || TO_CLOB('# and imported by the test harness (CPython 3), so keep it compatible with both.') || CHR(10) || TO_CLOB('import math') || CHR(10) || CHR(10) || TO_CLOB('# ---- Published formulas and limits ------------------------------------------------------------------------') || CHR(10) || TO_CLOB('# VERIFY against your licensed copies of ASME B31.8S and B31G before production use; keep under change control.') || CHR(10) || TO_CLOB('FLOW_ADD = 69.0') || RPAD(' ', 12) || TO_CLOB('# MPa: Modified B31G flow stress = SMYS + 69 MPa (10 ksi)') || CHR(10) || TO_CLOB('DEPTH_IMMEDIATE = 0.80') || RPAD(' ', 5) || TO_CLOB('# B31.8S 7.2.1: metal loss deeper than 80 % of wall -> immediate response') || CHR(10) || TO_CLOB('PF_IMMEDIATE = 1.10') || RPAD(' ', 8) || TO_CLOB('# B31.8S 7.2.1: predicted failure pressure below 1.1 x MAOP -> immediate response') || CHR(10) || TO_CLOB('DENT_SCHEDULED = 6.0') || RPAD(' ', 7) || TO_CLOB('# B31.8S 7.2.2: plain dent deeper than 6 % of the diameter -> scheduled response') || CHR(10) || TO_CLOB('PIR_K = 0.099') || RPAD(' ', 14) || TO_CLOB('# B31.8S 3.2 (SI): potential impact radius r = 0.099 * sqrt(d^2 * p), d mm, p MPa -> m') || CHR(10) || TO_CLOB('DESIGN_F = {"1": 0.72, "2": 0.60, "3": 0.50, "4": 0.40}') || RPAD(' ', 3) || TO_CLOB('# ASME B31.8 design factor by class location') || CHR(10) || TO_CLOB('# B31.8S Table 3, time-dependent threats, ILI or pressure test: (hoop stress band lower limit in %SMYS,') || CHR(10) || TO_CLOB('# [(minimum predicted failure pressure ratio Pf/MAOP, interval in years), ...] longest interval first)') || CHR(10) || TO_CLOB('TABLE3 = ((50.0, ((1.39, 10.0), (1.25, 5.0))),') || CHR(10) || RPAD(' ', 10) || TO_CLOB('(30.0, ((1.70, 15.0), (1.40, 10.0))),') || CHR(10) || RPAD(' ', 10) || TO_CLOB('(0.0, ((2.20, 20.0), (2.00, 15.0), (1.65, 10.0))))') || CHR(10) || CHR(10) || TO_CLOB('# ---- Company-configurable screening values (relative risk model, B31.8S 5.7 index approach) ---------------') || CHR(10) || TO_CLOB('SUSC_SCORE = {"HIGH": 4, "MEDIUM": 3, "LOW": 2, "NONE": 0}') || CHR(10) || TO_CLOB('COF_FIN = (1e4, 1e5, 1e6, 1e7)') || RPAD(' ', 10) || TO_CLOB('# financial CoF category A..E upper limits (USD), same scale as the RBI module') || CHR(10) || TO_CLOB('RISK_LEVEL = ((4, "LOW"), (6, "MEDIUM"), (7, "MEDHIGH"), (10, "HIGH"))') || RPAD(' ', 3) || TO_CLOB('# matrix score = PoF cat + CoF index') || CHR(10) || TO_CLOB('THREATS = ("EXTCORR", "INTCORR", "SCC", "MFG", "CONSTR", "EQUIP", "TPD", "INCOPS", "WEATHER")') || CHR(10) || TO_CLOB('ILI_THREATS = ("EXTCORR", "INTCORR")') || RPAD(' ', 4) || TO_CLOB('# time-dependent metal-loss threats scored from the ILI results') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def b31g_mod(od, wt, smys, depth_mm, length_mm):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""Modified B31G (0.85dL) predicted failure pressure in MPa for one metal-loss feature."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if wt <= 0 or od <= 0:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return 0.0') || CHR(10) || RPAD(' ', 4) || TO_CLOB('dt = min(max(depth_mm / wt, 0.0), 0.999)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('z = length_mm ** 2 / (od * wt)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if z <= 50.0:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('m = math.sqrt(1.0 + 0.6275 * z - 0.003375 * z * z)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('else:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('m = 0.032 * z + 3.3') || CHR(10) || RPAD(' ', 4) || TO_CLOB('sflow = smys + FLOW_ADD') || CHR(10) || RPAD(' ', 4) || TO_CLOB('sf = sflow * (1.0 - 0.85 * dt) / (1.0 - 0.85 * dt / m)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return 2.0 * sf * wt / od') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def hoop_pct(maop_mpa, od, wt, smys):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""Hoop stress at MAOP as a percentage of SMYS (Barlow)."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return 100.0 * maop_mpa * od / (2.0 * wt * smys)') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def pir(od, maop_mpa):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""Potential impact radius (m)."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return PIR_K * math.sqrt(od * od * maop_mpa)') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def feature_eval(f, seg, years_since_ili=0.0):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""Evaluate one anomaly at a time point years_since_ili after the ILI run.') || CHR(10) || RPAD(' ', 4) || TO_CLOB('f: dict(ftype, depthpct, length, dentpct, growth) ; seg: dict(od, wt, smys, maop (MPa), sf)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('Returns dict(depth, pf, psafe, erf, ratio, response)."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('depth = f["depthpct"] / 100.0 * seg["wt"] + f.get("growth", 0.0) * years_since_ili') || CHR(10) || RPAD(' ', 4) || TO_CLOB('ftype = f["ftype"]') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if ftype in ("METALLOSS", "DENTML"):') || CHR(10) || RPAD(' ', 8) || TO_CLOB('pf = b31g_mod(seg["od"], seg["wt"], seg["smys"], depth, f["length"])') || CHR(10) || RPAD(' ', 4) || TO_CLOB('else:') || RPAD(' ', 3) || TO_CLOB('# dents and cracks: the pipe body is not thinned; failure pressure of the intact pipe') || CHR(10) || RPAD(' ', 8) || TO_CLOB('pf = 2.0 * (seg["smys"] + FLOW_ADD) * seg["wt"] / seg["od"]') || CHR(10) || RPAD(' ', 4) || TO_CLOB('psafe = pf * seg["sf"]') || CHR(10) || RPAD(' ', 4) || TO_CLOB('erf = seg["maop"] / psafe if psafe > 0 else 99.0') || CHR(10) || RPAD(' ', 4) || TO_CLOB('ratio = pf / seg["maop"] if seg["maop"] > 0 else 99.0') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if ftype in ("DENTML", "CRACK") or depth / seg["wt"] > DEPTH_IMMEDIATE or ratio < PF_IMMEDIATE:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('resp = "IMMEDIATE"') || CHR(10) || RPAD(' ', 4) || TO_CLOB('elif erf >= 1.0 or (ftype == "DENT" and f.get("dentpct", 0.0) > DENT_SCHEDULED):') || CHR(10) || RPAD(' ', 8) || TO_CLOB('resp = "SCHEDULED"') || CHR(10) || RPAD(' ', 4) || TO_CLOB('else:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('resp = "MONITORED"') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return dict(depth=depth, pf=pf, psafe=psafe, erf=erf, ratio=ratio, response=resp)') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def remaining_life(f, seg, horizon=30.0):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""Years from the ILI run until a monitored metal-loss feature needs repair (ERF reaches 1 or it turns') || CHR(10) || RPAD(' ', 4) || TO_CLOB('immediate), with its depth growing at f[''growth''] mm/y. 99 when it never does within the horizon."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if f["ftype"] != "METALLOSS" or f.get("growth", 0.0) <= 0:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return 99.0') || CHR(10) || RPAD(' ', 4) || TO_CLOB('t = 0.0') || CHR(10) || RPAD(' ', 4) || TO_CLOB('while t <= horizon:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if feature_eval(f, seg, t)["response"] != "MONITORED":') || CHR(10) || RPAD(' ', 12) || TO_CLOB('return t') || CHR(10) || RPAD(' ', 8) || TO_CLOB('t += 1.0 / 12.0') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return 99.0') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def growth_rate(depthpct, prevdepthpct, wt, years_between, default):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""Depth growth (mm/y): ILI-to-ILI matched features use their own depth change, others the segment default."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if prevdepthpct is not None and prevdepthpct > 0 and years_between > 0 and depthpct >= prevdepthpct:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return (depthpct - prevdepthpct) / 100.0 * wt / years_between') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return default') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def table3_interval(hoop, ratio):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""B31.8S Table 3 interval (years) for the hoop stress band and the worst remaining predicted failure') || CHR(10) || RPAD(' ', 4) || TO_CLOB('pressure ratio. 0 means the ratio is below every row: the features must be remediated first."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('for lower, rows in TABLE3:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if hoop >= lower:') || CHR(10) || RPAD(' ', 12) || TO_CLOB('for r, years in rows:') || CHR(10) || RPAD(' ', 16) || TO_CLOB('if ratio >= r:') || CHR(10) || RPAD(' ', 20) || TO_CLOB('return years') || CHR(10) || RPAD(' ', 12) || TO_CLOB('return 0.0') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return 0.0') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def threat_score(susc, mitigated):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('s = SUSC_SCORE.get(susc, 0)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if mitigated and s > 1:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('s -= 1') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return s') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def ili_score(n_immediate, n_scheduled, min_life):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""Likelihood (1-5) of the metal-loss threats from the ILI results."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if n_immediate:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return 5') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if n_scheduled or min_life < 2.0:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return 4') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if min_life < 5.0:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return 3') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if min_life < 10.0:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return 2') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return 1') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def pof_category(scores):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('"""scores: dict threat -> 0..5. PoF category = governing threat, +1 when two or more threats score 3 or') || CHR(10) || RPAD(' ', 4) || TO_CLOB('more (B31.8S 2.2 interacting threats, e.g. external corrosion with third-party damage). Returns (cat, driver, interacting)."""') || CHR(10) || RPAD(' ', 4) || TO_CLOB('ranked = sorted(scores.items(), key=lambda kv: (-kv[1], THREATS.index(kv[0]) if kv[0] in THREATS else 99))') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if not ranked or ranked[0][1] <= 0:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return 1, "", []') || CHR(10) || RPAD(' ', 4) || TO_CLOB('top, driver = ranked[0][1], ranked[0][0]') || CHR(10) || RPAD(' ', 4) || TO_CLOB('inter = [k for k, v in ranked if v >= 3]') || CHR(10) || RPAD(' ', 4) || TO_CLOB('cat = min(5, top + (1 if len(inter) >= 2 else 0))') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return max(cat, 1), driver, inter') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def cof_people(buildings, identified_site):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if identified_site:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return "E"') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if buildings >= 20:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return "D"') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if buildings >= 10:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return "C"') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if buildings >= 1:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('return "B"') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return "A"') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def cof_category(value, limits):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('for i, lim in enumerate(limits):') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if value <= lim:') || CHR(10) || RPAD(' ', 12) || TO_CLOB('return "ABCDE"[i]') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return "E"') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def risk_level(pofcat, cofcat):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('score = pofcat + "ABCDE".index(cofcat) + 1') || CHR(10) || RPAD(' ', 4) || TO_CLOB('for lim, lvl in RISK_LEVEL:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if score <= lim:') || CHR(10) || RPAD(' ', 12) || TO_CLOB('return lvl') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return "HIGH"') || CHR(10) || CHR(10) || TO_CLOB('# inputs an approved or superseded assessment no longer accepts (generated by gen_pim.py)') || CHR(10) || TO_CLOB('FROZEN_INPUTS = (''ASSETNUM'', ''PIPELINE'', ''KPSTART'', ''KPEND'', ''INSTALLDATE'', ''COATING'', ''ASSESSDATE'', ''ASSESSOR'', ''CLASSLOC'', ''HCA'', ''OD'', ''WT'', ''GRADE'', ''SMYS'', ''MAOP'', ''ILIDATE'', ''ILIREPORTDATE'', ''ILITOOL'', ''PREVILIDATE'', ''DEFAULTCGR'', ''SAFETYF'', ''BUILDINGS'', ''IDSITE'', ''ENVSENS'', ''REPAIRCOST'', ''OUTAGEDAYS'', ''LOSSPERDAY'', ''ENVCOST'', ''MAXINTERVAL'', ''HCAMAX'')') || CHR(10) || TO_CLOB('CHILD_INPUTS = ((''THREATS'', (''THREAT'', ''SUSCEPT'', ''MITIGATED'', ''NOTES'')), (''ANOMALIES'', (''FEATURENUM'', ''KP'', ''CLOCK'', ''FTYPE'', ''SURFACE'', ''DEPTHPCT'', ''LENGTH'', ''WIDTH'', ''DENTPCT'', ''PREVDEPTHPCT'', ''FSTATUS'', ''REPAIRDATE'', ''REPAIRTYPE'')))') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('# ---- Maximo glue: read the assessment, run the model above, write the results ----------------------------') || CHR(10) || TO_CLOB('# Runs before every save of PIMASSESS (object launch point) and from Select Action > Recalculate Integrity.') || CHR(10) || TO_CLOB('from psdi.mbo import MboConstants') || CHR(10) || TO_CLOB('from java.util import Date, Calendar') || CHR(10) || CHR(10) || TO_CLOB('F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION') || CHR(10) || TO_CLOB('YEAR_MS = 365.25 * 24 * 3600 * 1000.0') || CHR(10) || TO_CLOB('METHOD = {"EXTCORR": "High-resolution MFL in-line inspection (or ECDA where unpiggable)",') || CHR(10) || RPAD(' ', 10) || TO_CLOB('"INTCORR": "MFL in-line inspection plus ICDA at low points and water drop-out sites",') || CHR(10) || RPAD(' ', 10) || TO_CLOB('"SCC": "EMAT crack-detection ILI or SCCDA digs at susceptible sites",') || CHR(10) || RPAD(' ', 10) || TO_CLOB('"MFG": "Hydrostatic test to 1.25 x MAOP (manufacturing defects)",') || CHR(10) || RPAD(' ', 10) || TO_CLOB('"CONSTR": "Geometry/deformation ILI and girth-weld review",') || CHR(10) || RPAD(' ', 10) || TO_CLOB('"EQUIP": "Station equipment inspection (valves, regulators, relief)",') || CHR(10) || RPAD(' ', 10) || TO_CLOB('"TPD": "Increased patrol, depth-of-cover survey, one-call compliance check",') || CHR(10) || RPAD(' ', 10) || TO_CLOB('"INCOPS": "Procedure review, operator qualification and overpressure protection check",') || CHR(10) || RPAD(' ', 10) || TO_CLOB('"WEATHER": "Geohazard survey and IMU/strain ILI at crossings"}') || CHR(10) || TO_CLOB('FTYPE_TXT = {"METALLOSS": "metal loss", "DENT": "dent", "DENTML": "dent with metal loss", "CRACK": "crack-like"}') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def years(d1, d2):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return (d2.getTime() - d1.getTime()) / YEAR_MS') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def add_years(d, y):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('cal = Calendar.getInstance()') || CHR(10) || RPAD(' ', 4) || TO_CLOB('cal.setTime(d)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('cal.add(Calendar.DAY_OF_YEAR, int(round(y * 365.25)))') || CHR(10) || RPAD(' ', 4) || TO_CLOB('return cal.getTime()') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def setv(o, attr, val):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if val is None:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('o.setValueNull(attr, F)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('else:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('o.setValue(attr, val, F)') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('# Approved and superseded assessments are frozen records: the approved basis stays as approved.') || CHR(10) || TO_CLOB('_st = mbo.getString("STATUS")') || CHR(10) || TO_CLOB('_frozen = _st == "SUPERSEDED" or (_st == "APPR" and not mbo.isModified("STATUS"))') || CHR(10) || TO_CLOB('if _frozen and launchPoint == "PIMCALC":') || CHR(10) || RPAD(' ', 4) || TO_CLOB('service.error("pim", "frozen")') || CHR(10) || TO_CLOB('if _frozen and not mbo.toBeAdded():') || CHR(10) || RPAD(' ', 4) || TO_CLOB('# integrations write without access checks: refuse changed inputs on a frozen record (the PIM scripts only') || CHR(10) || RPAD(' ', 4) || TO_CLOB('# write work order numbers and the status, which stay allowed)') || CHR(10) || RPAD(' ', 4) || TO_CLOB('_bad = [x for x in FROZEN_INPUTS if mbo.isModified(x)]') || CHR(10) || RPAD(' ', 4) || TO_CLOB('for _rel, _attrs in CHILD_INPUTS:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('_set = mbo.getMboSet(_rel)') || CHR(10) || RPAD(' ', 8) || TO_CLOB('_r = _set.moveFirst()') || CHR(10) || RPAD(' ', 8) || TO_CLOB('while _r is not None:') || CHR(10) || RPAD(' ', 12) || TO_CLOB('if _r.toBeAdded() or _r.toBeDeleted() or [x for x in _attrs if _r.isModified(x)]:') || CHR(10) || RPAD(' ', 16) || TO_CLOB('_bad.append(_rel)') || CHR(10) || RPAD(' ', 12) || TO_CLOB('_r = _set.moveNext()') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if _bad:') || CHR(10) || RPAD(' ', 8) || TO_CLOB('service.error("pim", "frozenedit", [mbo.getString("ASSESSNUM")])') || CHR(10) || CHR(10) || CHR(10) || TO_CLOB('def _run():') || CHR(10) || RPAD(' ', 4) || TO_CLOB('a = mbo') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if a.isNull("ASSESSDATE"):') || CHR(10) || RPAD(' ', 8) || TO_CLOB('setv(a, "ASSESSDATE", Date())') || CHR(10) || RPAD(' ', 4) || TO_CLOB('notes = []') || CHR(10) || RPAD(' ', 4) || TO_CLOB('cls = a.getString("CLASSLOC") or "1"') || CHR(10) || RPAD(' ', 4) || TO_CLOB('df = DESIGN_F.ge