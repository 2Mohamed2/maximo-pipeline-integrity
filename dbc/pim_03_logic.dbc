    <freeform description="script PIM.DIGWO">
      <sql target="sqlserver"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.DIGWO', 'Active', getdate(), getdate(), getdate(), 'MAXADMIN', next value for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: dig work orders for immediate and scheduled features', '1.0.0', CAST('# PIM.DIGWO - one dig work order per open immediate or scheduled ILI feature without a work order.' AS NVARCHAR(MAX)) + CHAR(10) + 'from psdi.mbo import MboConstants' + CHAR(10) + 'F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION' + CHAR(10) + 'a = mbo' + CHAR(10) + '# PIM.LOCK opens approved records read-only, and related sets inherit that flag: lift it on this record so' + CHAR(10) + '# the work order set accepts the new row (the save-time guard in PIM.CALC still refuses changed inputs)' + CHAR(10) + 'a.setFlag(MboConstants.READONLY, False)' + CHAR(10) + 'if a.getString("STATUS") != "APPR":' + CHAR(10) + SPACE(4) + 'service.error("pim", "notapproved")' + CHAR(10) + 'TXT = {"METALLOSS": "metal loss", "DENT": "dent", "DENTML": "dent with metal loss", "CRACK": "crack-like feature"}' + CHAR(10) + 'made, linked = [], []' + CHAR(10) + 'wos = a.getMboSet("$pimdigwo", "WORKORDER", "1=0")' + CHAR(10) + 'an = a.getMboSet("ANOMALIES")' + CHAR(10) + 'r = an.moveFirst()' + CHAR(10) + 'while r is not None:' + CHAR(10) + SPACE(4) + 'resp = r.getString("RESPONSE")' + CHAR(10) + SPACE(4) + 'if resp in ("IMMEDIATE", "SCHEDULED") and r.isNull("WONUM") and r.getString("FSTATUS") != "REPAIRED":' + CHAR(10) + SPACE(8) + '# a newer assessment of the same segment re-lists features whose dig is already open: link, never duplicate' + CHAR(10) + SPACE(8) + 'ex = a.getMboSet("$pimdig" + "".join(c for c in r.getString("FEATURENUM") if c.isalnum()), "WORKORDER", "siteid=:siteid and assetnum=:assetnum and worktype=''DIG'' and "' + CHAR(10) + SPACE(25) + '"description like ''Dig %s %%'' and status not in (select value from synonymdomain where "' + CHAR(10) + SPACE(25) + '"domainid=''WOSTATUS'' and maxvalue in (''CAN'',''CLOSE'',''COMP''))" % r.getString("FEATURENUM"))' + CHAR(10) + SPACE(8) + 'ex.reset()' + CHAR(10) + SPACE(8) + 'if not ex.isEmpty():' + CHAR(10) + SPACE(12) + 'r.setValue("WONUM", ex.getMbo(0).getString("WONUM"), F)' + CHAR(10) + SPACE(12) + 'linked.append(ex.getMbo(0).getString("WONUM"))' + CHAR(10) + SPACE(12) + 'r = an.moveNext()' + CHAR(10) + SPACE(12) + 'continue' + CHAR(10) + SPACE(8) + 'wo = wos.add()' + CHAR(10) + SPACE(8) + 'wo.setValue("SITEID", a.getString("SITEID"), F)' + CHAR(10) + SPACE(8) + 'wo.setValue("ASSETNUM", a.getString("ASSETNUM"))' + CHAR(10) + SPACE(8) + 'wo.setValue("WORKTYPE", "DIG")' + CHAR(10) + SPACE(8) + 'size = ("%.1f%% OD" % r.getDouble("DENTPCT")) if r.getString("FTYPE") == "DENT" else ("%.0f%% wt" % r.getDouble("DEPTHPCT"))' + CHAR(10) + SPACE(8) + 'wo.setValue("DESCRIPTION", ("Dig %s KP %.3f: %s %s, %s" % (r.getString("FEATURENUM"), r.getDouble("KP"),' + CHAR(10) + SPACE(20) + 'TXT.get(r.getString("FTYPE"), r.getString("FTYPE")), size, resp.lower()))[:100])' + CHAR(10) + SPACE(8) + 'wo.setValue("WOPRIORITY", 1 if resp == "IMMEDIATE" else 2)' + CHAR(10) + SPACE(8) + 'if not r.isNull("DUEDATE"):' + CHAR(10) + SPACE(12) + 'wo.setValue("TARGCOMPDATE", r.getDate("DUEDATE"))' + CHAR(10) + SPACE(12) + 'wo.setValue("TARGSTARTDATE", r.getDate("DUEDATE"))' + CHAR(10) + SPACE(8) + 'wo.setValue("DESCRIPTION_LONGDESCRIPTION",' + CHAR(10) + SPACE(20) + '"Raised by pipeline integrity assessment %s.\nFeature %s at KP %.3f, %s o''clock, %s surface.\n"' + CHAR(10) + SPACE(20) + '"Depth %.1f %% wt, dent %.1f %% OD, length %.0f mm, growth %.3f mm/y.\n%s: Pf %.1f bar, safe pressure "' + CHAR(10) + SPACE(20) + '"%.1f bar, ERF %.3f, Pf/MAOP %.3f -> B31.8S response %s.%s\n\nExcavate, measure (NDE), "' + CHAR(10) + SPACE(20) + '"assess and repair; record the repair on the feature (status REPAIRED, repair date, repair type)."' + CHAR(10) + SPACE(20) + '% (a.getString("ASSESSNUM"), r.getString("FEATURENUM"), r.getDouble("KP"), r.getString("CLOCK"),' + CHAR(10) + SPACE(23) + 'r.getString("SURFACE"), r.getDouble("DEPTHPCT"), r.getDouble("DENTPCT"), r.getDouble("LENGTH"), r.getDouble("GROWTH"),' + CHAR(10) + SPACE(23) + '"Modified B31G" if r.getString("FTYPE") in ("METALLOSS", "DENTML") else' + CHAR(10) + SPACE(23) + '"Intact pipe (response set by the feature type and dent depth)", r.getDouble("PF"), r.getDouble("PSAFE"), r.getDouble("ERF"), r.getDouble("PFRATIO"), resp,' + CHAR(10) + SPACE(23) + '"\nIMMEDIATE: reduce operating pressure until the repair is complete." if resp == "IMMEDIATE" else ""))' + CHAR(10) + SPACE(8) + 'r.setValue("WONUM", wo.getString("WONUM"), F)' + CHAR(10) + SPACE(8) + 'made.append(wo.getString("WONUM"))' + CHAR(10) + SPACE(4) + 'r = an.moveNext()' + CHAR(10) + 'if not made and not linked:' + CHAR(10) + SPACE(4) + 'service.error("pim", "nodigs")' + CHAR(10) where not exists (select 1 from autoscript where autoscript='PIM.DIGWO')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMDIGWO', 'PIM.DIGWO', 'Create Dig Work Orders', 'ACTION', 'PIMASSESS', null, null, 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMDIGWO')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into action (actionid, action, description, objectname, type, value, parameter, langcode, usewith, hasld) select next value for actionseq, 'PIMDIGWO', 'Create Dig Work Orders', 'PIMASSESS', 'CUSTOM', 'com.ibm.tivoli.maximo.script.ScriptAction', 'PIM.DIGWO,PIMDIGWO,PIMDIGWO', 'EN', 'ALL', 0 where not exists (select 1 from action where action='PIMDIGWO')]]></sql>
      <sql target="oracle"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.DIGWO', 'Active', sysdate, sysdate, sysdate, 'MAXADMIN', autoscriptseq.nextval, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: dig work orders for immediate and scheduled features', '1.0.0', TO_CLOB('# PIM.DIGWO - one dig work order per open immediate or scheduled ILI feature without a work order.') || CHR(10) || TO_CLOB('from psdi.mbo import MboConstants') || CHR(10) || TO_CLOB('F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION') || CHR(10) || TO_CLOB('a = mbo') || CHR(10) || TO_CLOB('# PIM.LOCK opens approved records read-only, and related sets inherit that flag: lift it on this record so') || CHR(10) || TO_CLOB('# the work order set accepts the new row (the save-time guard in PIM.CALC still refuses changed inputs)') || CHR(10) || TO_CLOB('a.setFlag(MboConstants.READONLY, False)') || CHR(10) || TO_CLOB('if a.getString("STATUS") != "APPR":') || CHR(10) || RPAD(' ', 4) || TO_CLOB('service.error("pim", "notapproved")') || CHR(10) || TO_CLOB('TXT = {"METALLOSS": "metal loss", "DENT": "dent", "DENTML": "dent with metal loss", "CRACK": "crack-like feature"}') || CHR(10) || TO_CLOB('made, linked = [], []') || CHR(10) || TO_CLOB('wos = a.getMboSet("$pimdigwo", "WORKORDER", "1=0")') || CHR(10) || TO_CLOB('an = a.getMboSet("ANOMALIES")') || CHR(10) || TO_CLOB('r = an.moveFirst()') || CHR(10) || TO_CLOB('while r is not None:') || CHR(10) || RPAD(' ', 4) || TO_CLOB('resp = r.getString("RESPONSE")') || CHR(10) || RPAD(' ', 4) || TO_CLOB('if resp in ("IMMEDIATE", "SCHEDULED") and r.isNull("WONUM") and r.getString("FSTATUS") != "REPAIRED":') || CHR(10) || RPAD(' ', 8) || TO_CLOB('# a newer assessment of the same segment re-lists features whose dig is already open: link, never duplicate') || CHR(10) || RPAD(' ', 8) || TO_CLOB('ex = a.getMboSet("$pimdig" + "".join(c for c in r.getString("FEATURENUM") if c.isalnum()), "WORKORDER", "siteid=:siteid and assetnum=:assetnum and worktype=''DIG'' and "') || CHR(10) || RPAD(' ', 25) || TO_CLOB('"description like ''Dig %s %%'' and status not in (select value from synonymdomain where "') || CHR(10) || RPAD(' ', 25) || TO_CLOB('"domainid=''WOSTATUS'' and maxvalue in (''CAN'',''CLOSE'',''COMP''))" % r.getString("FEATURENUM"))') || CHR(10) || RPAD(' ', 8) || TO_CLOB('ex.reset()') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if not ex.isEmpty():') || CHR(10) || RPAD(' ', 12) || TO_CLOB('r.setValue("WONUM", ex.getMbo(0).getString("WONUM"), F)') || CHR(10) || RPAD(' ', 12) || TO_CLOB('linked.append(ex.getMbo(0).getString("WONUM"))') || CHR(10) || RPAD(' ', 12) || TO_CLOB('r = an.moveNext()') || CHR(10) || RPAD(' ', 12) || TO_CLOB('continue') || CHR(10) || RPAD(' ', 8) || TO_CLOB('wo = wos.add()') || CHR(10) || RPAD(' ', 8) || TO_CLOB('wo.setValue("SITEID", a.getString("SITEID"), F)') || CHR(10) || RPAD(' ', 8) || TO_CLOB('wo.setValue("ASSETNUM", a.getString("ASSETNUM"))') || CHR(10) || RPAD(' ', 8) || TO_CLOB('wo.setValue("WORKTYPE", "DIG")') || CHR(10) || RPAD(' ', 8) || TO_CLOB('size = ("%.1f%% OD" % r.getDouble("DENTPCT")) if r.getString("FTYPE") == "DENT" else ("%.0f%% wt" % r.getDouble("DEPTHPCT"))') || CHR(10) || RPAD(' ', 8) || TO_CLOB('wo.setValue("DESCRIPTION", ("Dig %s KP %.3f: %s %s, %s" % (r.getString("FEATURENUM"), r.getDouble("KP"),') || CHR(10) || RPAD(' ', 20) || TO_CLOB('TXT.get(r.getString("FTYPE"), r.getString("FTYPE")), size, resp.lower()))[:100])') || CHR(10) || RPAD(' ', 8) || TO_CLOB('wo.setValue("WOPRIORITY", 1 if resp == "IMMEDIATE" else 2)') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if not r.isNull("DUEDATE"):') || CHR(10) || RPAD(' ', 12) || TO_CLOB('wo.setValue("TARGCOMPDATE", r.getDate("DUEDATE"))') || CHR(10) || RPAD(' ', 12) || TO_CLOB('wo.setValue("TARGSTARTDATE", r.getDate("DUEDATE"))') || CHR(10) || RPAD(' ', 8) || TO_CLOB('wo.setValue("DESCRIPTION_LONGDESCRIPTION",') || CHR(10) || RPAD(' ', 20) || TO_CLOB('"Raised by pipeline integrity assessment %s.\nFeature %s at KP %.3f, %s o''clock, %s surface.\n"') || CHR(10) || RPAD(' ', 20) || TO_CLOB('"Depth %.1f %% wt, dent %.1f %% OD, length %.0f mm, growth %.3f mm/y.\n%s: Pf %.1f bar, safe pressure "') || CHR(10) || RPAD(' ', 20) || TO_CLOB('"%.1f bar, ERF %.3f, Pf/MAOP %.3f -> B31.8S response %s.%s\n\nExcavate, measure (NDE), "') || CHR(10) || RPAD(' ', 20) || TO_CLOB('"assess and repair; record the repair on the feature (status REPAIRED, repair date, repair type)."') || CHR(10) || RPAD(' ', 20) || TO_CLOB('% (a.getString("ASSESSNUM"), r.getString("FEATURENUM"), r.getDouble("KP"), r.getString("CLOCK"),') || CHR(10) || RPAD(' ', 23) || TO_CLOB('r.getString("SURFACE"), r.getDouble("DEPTHPCT"), r.getDouble("DENTPCT"), r.getDouble("LENGTH"), r.getDouble("GROWTH"),') || CHR(10) || RPAD(' ', 23) || TO_CLOB('"Modified B31G" if r.getString("FTYPE") in ("METALLOSS", "DENTML") else') || CHR(10) || RPAD(' ', 23) || TO_CLOB('"Intact pipe (response set by the feature type and dent depth)", r.getDouble("PF"), r.getDouble("PSAFE"), r.getDouble("ERF"), r.getDouble("PFRATIO"), resp,') || CHR(10) || RPAD(' ', 23) || TO_CLOB('"\nIMMEDIATE: reduce operating pressure until the repair is complete." if resp == "IMMEDIATE" else ""))') || CHR(10) || RPAD(' ', 8) || TO_CLOB('r.setValue("WONUM", wo.getString("WONUM"), F)') || CHR(10) || RPAD(' ', 8) || TO_CLOB('made.append(wo.getString("WONUM"))') || CHR(10) || RPAD(' ', 4) || TO_CLOB('r = an.moveNext()') || CHR(10) || TO_CLOB('if not made and not linked:') || CHR(10) || RPAD(' ', 4) || TO_CLOB('service.error("pim", "nodigs")') || CHR(10) from dual where not exists (select 1 from autoscript where autoscript='PIM.DIGWO')]]></sql>
