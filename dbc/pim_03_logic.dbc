    <freeform description="script PIM.LOCK">
      <sql target="sqlserver"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.LOCK', 'Active', getdate(), getdate(), getdate(), 'MAXADMIN', next value for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: approved and superseded assessments open read-only', '1.0.0', CAST('# PIM.LOCK - approved and superseded assessments are frozen records: the assessment, its threats and its' AS NVARCHAR(MAX)) + CHAR(10) + '# ILI features open read-only. The PIM scripts still write their own fields (they bypass access checks).' + CHAR(10) + 'from psdi.mbo import MboConstants' + CHAR(10) + 'a = mbo if mbo.getName() == "PIMASSESS" else mbo.getOwner()' + CHAR(10) + 'if a is not None and a.getName() == "PIMASSESS" and not a.toBeAdded() and' + SPACE(9) + 'a.getMboValue("STATUS").getPreviousValue().asString() in ("APPR", "SUPERSEDED"):' + CHAR(10) + SPACE(4) + 'mbo.setFlag(MboConstants.READONLY, True)' + CHAR(10) where not exists (select 1 from autoscript where autoscript='PIM.LOCK')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMLOCKASS', 'PIM.LOCK', 'Open PIMASSESS read-only when the assessment is approved or superseded', 'OBJECT', 'PIMASSESS', 1, null, 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMLOCKASS')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMLOCKTHR', 'PIM.LOCK', 'Open PIMTHREAT read-only when the assessment is approved or superseded', 'OBJECT', 'PIMTHREAT', 1, null, 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMLOCKTHR')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMLOCKANO', 'PIM.LOCK', 'Open PIMANOM read-only when the assessment is approved or superseded', 'OBJECT', 'PIMANOM', 1, null, 1, next value for scriptlaunchpointseq where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMLOCKANO')]]></sql>
      <sql target="oracle"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.LOCK', 'Active', sysdate, sysdate, sysdate, 'MAXADMIN', autoscriptseq.nextval, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: approved and superseded assessments open read-only', '1.0.0', TO_CLOB('# PIM.LOCK - approved and superseded assessments are frozen records: the assessment, its threats and its') || CHR(10) || TO_CLOB('# ILI features open read-only. The PIM scripts still write their own fields (they bypass access checks).') || CHR(10) || TO_CLOB('from psdi.mbo import MboConstants') || CHR(10) || TO_CLOB('a = mbo if mbo.getName() == "PIMASSESS" else mbo.getOwner()') || CHR(10) || TO_CLOB('if a is not None and a.getName() == "PIMASSESS" and not a.toBeAdded() and') || RPAD(' ', 9) || TO_CLOB('a.getMboValue("STATUS").getPreviousValue().asString() in ("APPR", "SUPERSEDED"):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('mbo.setFlag(MboConstants.READONLY, True)') || CHR(10) from dual where not exists (select 1 from autoscript where autoscript='PIM.LOCK')]]></sql>
      <sql target="oracle"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMLOCKASS', 'PIM.LOCK', 'Open PIMASSESS read-only when the assessment is approved or superseded', 'OBJECT', 'PIMASSESS', 1, null, 1, scriptlaunchpointseq.nextval from dual where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMLOCKASS')]]></sql>
