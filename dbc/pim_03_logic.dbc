    <freeform description="script PIM.MARKOWNER">
      <sql target="sqlserver"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.MARKOWNER', 'Active', getdate(), getdate(), getdate(), 'MAXADMIN', next value for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: a changed feature or threat row marks its draft assessment for recalculation', '1.0.0', CAST('# PIM.MARKOWNER - a feature or threat value set on the screen or over REST marks its draft assessment as changed,' AS NVARCHAR(MAX)) + CHAR(10) + '# so PIM.CALC (before save) runs even when only child rows were added or edited.' + CHAR(10) + 'from psdi.mbo import MboConstants' + CHAR(10) + 'o = mbo.getOwner()' + CHAR(10) + 'if o is not None and o.getName() == "PIMASSESS" and o.getString("STATUS") == "DRAFT" and not o.isModified("CALCNOTE"):' + CHAR(10) + SPACE(4) + 'o.setValue("CALCNOTE", "Recalculating after a feature or threat change.", MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION)' + CHAR(10) where not exists (select 1 from autoscript where autoscript='PIM.MARKOWNER')]]></sql>
      <sql target="oracle"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.MARKOWNER', 'Active', sysdate, sysdate, sysdate, 'MAXADMIN', autoscriptseq.nextval, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: a changed feature or threat row marks its draft assessment for recalculation', '1.0.0', TO_CLOB('# PIM.MARKOWNER - a feature or threat value set on the screen or over REST marks its draft assessment as changed,') || CHR(10) || TO_CLOB('# so PIM.CALC (before save) runs even when only child rows were added or edited.') || CHR(10) || TO_CLOB('from psdi.mbo import MboConstants') || CHR(10) || TO_CLOB('o = mbo.getOwner()') || CHR(10) || TO_CLOB('if o is not None and o.getName() == "PIMASSESS" and o.getString("STATUS") == "DRAFT" and not o.isModified("CALCNOTE"):') || CHR(10) || RPAD(' ', 4) || TO_CLOB('o.setValue("CALCNOTE", "Recalculating after a feature or threat change.", MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION)') || CHR(10) from dual where not exists (select 1 from autoscript where autoscript='PIM.MARKOWNER')]]></sql>
