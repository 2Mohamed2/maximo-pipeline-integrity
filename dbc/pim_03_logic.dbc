 || TO_CLOB('if ft == "DENTML":') || CHR(10) || RPAD(' ', 12) || TO_CLOB('mech = surf["TPD"]') || CHR(10) || RPAD(' ', 12) || TO_CLOB('mech["n"] += 1') || CHR(10) || RPAD(' ', 12) || TO_CLOB('mech["i"] += resp == "IMMEDIATE"') || CHR(10) || RPAD(' ', 8) || TO_CLOB('sk = surf[key]') || CHR(10) || RPAD(' ', 8) || TO_CLOB('sk["n"] += 1') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if sk is not None:') || CHR(10) || RPAD(' ', 12) || TO_CLOB('sk["i"] += resp == "IMMEDIATE"') || CHR(10) || RPAD(' ', 12) || TO_CLOB('sk["s"] += resp == "SCHEDULED"') || CHR(10) || RPAD(' ', 12) || TO_CLOB('if resp == "MONITORED":') || CHR(10) || RPAD(' ', 16) || TO_CLOB('sk["life"] = min(sk["life"], life)') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if e["erf"] > max_erf:') || CHR(10) || RPAD(' ', 12) || TO_CLOB('max_erf, worst = e["erf"], r.getString("FEATURENUM")') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if resp == "MONITORED":') || CHR(10) || RPAD(' ', 12) || TO_CLOB('min_ratio = min(min_ratio, e["ratio"])') || CHR(10) || RPAD(' ', 12) || TO_CLOB('min_life = min(min_life, life)') || CHR(10) || RPAD(' ', 8) || TO_CLOB('if resp == "IMMEDIATE":') || CHR(10) || RPAD(' ', 12) || TO_CLOB('due = rep') || CHR(10) || RPAD(' ', 8) || TO_CLOB('elif resp == "SCHEDULED":') || CHR(10) || RPAD(' ', 12) || TO_CLOB('due = add_years(rep, 1.0) if rep is not None else None') || CHR(10) || RPAD(' ', 8) || TO_CLOB('else:') || CHR(10) || RPAD(' ', 12) || TO_CLOB('due = add_years(ili, life) if (ili is not None and life < 99.0) else None') || CHR(10) || RPAD(' ', 8) || TO_CLOB('for k, v in (("GROWTH", round(g, 3)), ("PF", round(e["pf"] * 10.0, 1)), ("PSAFE", round(e["psafe"] * 10.0, 1)),') || CHR(10) || RPAD(' ', 21) || TO_CLOB('("ERF", round(e["erf"], 3)), ("PFRATIO", round(e["ratio"], 3)), ("RESPONSE", resp),') || CHR(10) || RPAD(' ', 21) || TO_CLOB('("REMLIFE", round(life, 1) if life < 99.0 else None), ("DUEDATE", due)):') || CHR(10) || RPAD(' ', 12) || TO_CLOB('setv(r, k, v)') || CHR(10) || RPAD(' ', 8) || TO_CLOB('r =