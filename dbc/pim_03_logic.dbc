), a.getDouble("KPSTART"),') || CHR(10) || RPAD(' ', 12) || TO_CLOB('a.getDouble("KPEND"), a.getString("ASSESSMETHOD")))[:100])') || CHR(10) || TO_CLOB('wo.setValue("WOPRIORITY", prio)') || CHR(10) || TO_CLOB('wo.setValue("TARGSTARTDATE", a.getDate("NEXTASSESSDATE"))') || CHR(10) || TO_CLOB('wo.setValue("DESCRIPTION_LONGDESCRIPTION",') || CHR(10) || RPAD(' ', 12) || TO_CLOB('"Raised by pipeline integrity assessment %s (risk %s %s, governing threat %s).\nInterval set by: %s.\n\n%s"') || CHR(10) || RPAD(' ', 12) || TO_CLOB('% (a.getString("ASSESSNUM"), a.getString("RISKCELL"), a.getString("RISK"), a.getString("DRIVER"),') || CHR(10) || RPAD(' ', 15) || TO_CLOB('a.getString("INTERVALBASIS"), a.getString("CALCNOTE")))') || CHR(10) || TO_CLOB('a.setValue("WONUM", wo.getString("WONUM"), F)') || CHR(10) from dual where not exists (select 1 from autoscript where autoscript='PIM.REASSESSWO')]]></sql>
      <sql target="oracle"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMREWO', 'PIM.REASSESSWO', 'Create Reassessment Work Order', 'ACTION', 'PIMASSESS', null, null, 1, scriptlaunchpointseq.nextval from dual where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMREWO')]]></sql>
      <sql target="oracle"><![CDATA[insert into action (actionid, action, description, objectname, type, value, parameter, langcode, usewith, hasld) select actionseq.nextval, 'PIMREWO', 'Create Reassessment Work Order', 'PIMASSESS', 'CUSTOM', 'com.ibm.tivoli.maximo.script.ScriptAction', 'PIM.REASSESSWO,PIMREWO,PIMREWO', 'EN', 'ALL', 0 from dual where not exists (select 1 from action where action='PIMREWO')]]></sql>
      <sql target="db2"><![CDATA[insert into autoscript (autoscript, status, createddate, statusdate, changedate, changeby, autoscriptid, hasld, langcode, scriptlanguage, userdefined, loglevel, interface, active, description, version, source) select 'PIM.REASSESSWO', 'Active', current timestamp, current timestamp, current timestamp, 'MAXADMIN', nextval for autoscriptseq, 0, 'EN', 'jython', 1, 'ERROR', 0, 1, 'PIM: reassessment work order of an approved assessment', '1.0.0', CAST('# PIM.REASSESSWO - the reassessment work order (next ILI run) of an approved assessment.' AS CLOB) || CHR(10) || '# Runs from Select Action > Create Reassessment Work Order and from the PIMDUE escalation.' || CHR(10) || 'from psdi.mbo import MboConstants' || CHR(10) || 'F = MboConstants.NOACCESSCHECK | MboConstants.NOVALIDATION_AND_NOACTION' || CHR(10) || 'a = mbo' || CHR(10) || '# PIM.LOCK opens approved records read-only, and related sets inherit that flag: lift it on this record so' || CHR(10) || '# the work order set accepts the new row (the save-time guard in PIM.CALC still refuses changed inputs)' || CHR(10) || 'a.setFlag(MboConstants.READONLY, False)' || CHR(10) || 'if a.getString("STATUS") != "APPR":' || CHR(10) || REPEAT(' ', 4) || 'service.error("pim", "notapproved")' || CHR(10) || 'if not a.isNull("WONUM"):' || CHR(10) || REPEAT(' ', 4) || 'service.error("pim", "woexists", [a.getString("WONUM")])' || CHR(10) || 'prio = {"HIGH": 1, "MEDHIGH": 2, "MEDIUM": 3, "LOW": 4}.get(a.getString("RISK"), 3)' || CHR(10) || 'wos = a.getMboSet("$pimrewo", "WORKORDER", "1=0")' || CHR(10) || 'wo = wos.add()' || CHR(10) || 'wo.setValue("SITEID", a.getString("SITEID"), F)' || CHR(10) || 'wo.setValue("ASSETNUM", a.getString("ASSETNUM"))' || CHR(10) || 'wo.setValue("WORKTYPE", "INSP")' || CHR(10) || 'wo.setValue("DESCRIPTION", ("Reassess %s KP %.1f-%.1f: %s" % (a.getString("ASSETNUM"), a.getDouble("KPSTART"),' || CHR(10) || REPEAT(' ', 12) || 'a.getDouble("KPEND"), a.getString("ASSESSMETHOD")))[:100])' || CHR(10) || 'wo.setValue("WOPRIORITY", prio)' || CHR(10) || 'wo.setValue("TARGSTARTDATE", a.getDate("NEXTASSESSDATE"))' || CHR(10) || 'wo.setValue("DESCRIPTION_LONGDESCRIPTION",' || CHR(10) || REPEAT(' ', 12) || '"Raised by pipeline integrity assessment %s (risk %s %s, governing threat %s).\nInterval set by: %s.\n\n%s"' || CHR(10) || REPEAT(' ', 12) || '% (a.getString("ASSESSNUM"), a.getString("RISKCELL"), a.getString("RISK"), a.getString("DRIVER"),' || CHR(10) || REPEAT(' ', 15) || 'a.getString("INTERVALBASIS"), a.getString("CALCNOTE")))' || CHR(10) || 'a.setValue("WONUM", wo.getString("WONUM"), F)' || CHR(10) from sysibm.sysdummy1 where not exists (select 1 from autoscript where autoscript='PIM.REASSESSWO')]]></sql>
      <sql target="db2"><![CDATA[insert into scriptlaunchpoint (launchpointname, autoscript, description, launchpointtype, objectname, objectevent, condition, active, scriptlaunchpointid) select 'PIMREWO', 'PIM.REASSESSWO', 'Create Reassessment Work Order', 'ACTION', 'PIMASSESS', null, null, 1, nextval for scriptlaunchpointseq from sysibm.sysdummy1 where not exists (select 1 from scriptlaunchpoint where launchpointname='PIMREWO')]]></sql>
