    <freeform description="escalation PIMDUE">
      <sql target="sqlserver"><![CDATA[insert into escalation (escalationid, description, active, objectname, condition, changeby, changedate, crontaskname, instancename, escalation, schedule, langcode, hasld, escstatusflag, pluspondemand, pluspsourceapp) select (select coalesce(max(escalationid),0)+1 from escalation), 'PIM: raise the reassessment work order 180 days before it is due', 1, 'PIMASSESS', 'status=''APPR'' and wonum is null', 'MAXADMIN', getdate(), 'ESCALATION', 'PIMDUE', 'PIMDUE', '1d,0,30,2,*,*,*,*,*,*', 'EN', 0, 1, 0, 0 where not exists (select 1 from escalation where escalation='PIMDUE')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into escrefpoint (escalation, refpointnum, eventcondition, elapsedinterval, intervaluom, repeat, refpointid, eventattribute, action) select 'PIMDUE', 1, null, -180, 'DAYS', 0, (select coalesce(max(refpointid),0)+1 from escrefpoint), 'NEXTASSESSDATE', 'PIMREWO' where not exists (select 1 from escrefpoint where escalation='PIMDUE' and refpointnum=1)]]></sql>
      <sql target="sqlserver"><![CDATA[insert into crontaskinstance (crontaskname, instancename, schedule, active, description, crontaskinstanceid, runasuserid, langcode, hasld, autoremoval, keephistory, maxhistory) select 'ESCALATION', 'PIMDUE', '1d,0,30,2,*,*,*,*,*,*', 1, 'Pipeline reassessment due escalation', next value for crontaskinstanceseq, 'MAXADMIN', 'EN', 0, 0, 1, 100 where not exists (select 1 from crontaskinstance where crontaskname='ESCALATION' and instancename='PIMDUE')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into crontaskparam (crontaskname, instancename, parameter, value, crontaskparamid) select 'ESCALATION', 'PIMDUE', 'ESCALATION', 'PIMDUE', next value for crontaskparamseq where not exists (select 1 from crontaskparam where crontaskname='ESCALATION' and instancename='PIMDUE' and parameter='ESCALATION')]]></sql>
      <sql target="oracle"><![CDATA[insert into escalation (escalationid, description, active, objectname, condition, changeby, changedate, crontaskname, instancename, escalation, schedule, langcode, hasld, escstatusflag, pluspondemand, pluspsourceapp) select (select coalesce(max(escalationid),0)+1 from escalation), 'PIM: raise the reassessment work order 180 days before it is due', 1, 'PIMASSESS', 'status=''APPR'' and wonum is null', 'MAXADMIN', sysdate, 'ESCALATION', 'PIMDUE', 'PIMDUE', '1d,0,30,2,*,*,*,*,*,*', 'EN', 0, 1, 0, 0 from dual where not exists (select 1 from escalation where escalation='PIMDUE')]]></sql>
      <sql target="oracle"><![CDATA[insert into escrefpoint (escalation, refpointnum, eventcondition, elapsedinterval, intervaluom, repeat, refpointid, eventattribute, action) select 'PIMDUE', 1, null, -180, 'DAYS', 0, (select coalesce(max(refpointid),0)+1 from escrefpoint), 'NEXTASSESSDATE', 'PIMREWO' from dual where not exists (select 1 from escrefpoint where escalation='PIMDUE' and refpointnum=1)]]></sql>
      <sql target="oracle"><![CDATA[insert into crontaskinstance (crontaskname, instancename, schedule, active, description, crontaskinstanceid, runasuserid, langcode, hasld, autoremoval, keephistory, maxhistory) select 'ESCALATION', 'PIMDUE', '1d,0,30,2,*,*,*,*,*,*', 1, 'Pipeline reassessment due escalation', crontaskinstanceseq.nextval, 'MAXADMIN', 'EN', 0, 0, 1, 100 from dual where not exists (select 1 from crontaskinstance where crontaskname='ESCALATION' and instancename='PIMDUE')]]></sql>
      <sql target="oracle"><![CDATA[insert into crontaskparam (crontaskname, instancename, parameter, value, crontaskparamid) select 'ESCALATION', 'PIMDUE', 'ESCALATION', 'PIMDUE', crontaskparamseq.nextval from dual where not exists (select 1 from crontaskparam where crontaskname='ESCALATION' and instancename='PIMDUE' and parameter='ESCALATION')]]></sql>
      <sql target="db2"><![CDATA[insert into escalation (escalationid, description, active, objectname, condition, changeby, changedate, crontaskname, instancename, escalation, schedule, langcode, hasld, escstatusflag, pluspondemand, pluspsourceapp) select (select coalesce(max(escalationid),0)+1 from escalation), 'PIM: raise the reassessment work order 180 days before it is due', 1, 'PIMASSESS', 'status=''APPR'' and wonum is null', 'MAXADMIN', current timestamp, 'ESCALATION', 'PIMDUE', 'PIMDUE', '1d,0,30,2,*,*,*,*,*,*', 'EN', 0, 1, 0, 0 from sysibm.sysdummy1 where not exists (select 1 from escalation where escalation='PIMDUE')]]></sql>
      <sql target="db2"><![CDATA[insert into escrefpoint (escalation, refpointnum, eventcondition, elapsedinterval, intervaluom, repeat, refpointid, eventattribute, action) select 'PIMDUE', 1, null, -180, 'DAYS', 0, (select coalesce(max(refpointid),0)+1 from escrefpoint), 'NEXTASSESSDATE', 'PIMREWO' from sysibm.sysdummy1 where not exists (select 1 from escrefpoint where escalation='PIMDUE' and refpointnum=1)]]></sql>
      <sql target="db2"><![CDATA[insert into crontaskinstance (crontaskname, instancename, schedule, active, description, crontaskinstanceid, runasuserid, langcode, hasld, autoremoval, keephistory, maxhistory) select 'ESCALATION', 'PIMDUE', '1d,0,30,2,*,*,*,*,*,*', 1, 'Pipeline reassessment due escalation', nextval for crontaskinstanceseq, 'MAXADMIN', 'EN', 0, 0, 1, 100 from sysibm.sysdummy1 where not exists (select 1 from crontaskinstance where crontaskname='ESCALATION' and instancename='PIMDUE')]]></sql>
      <sql target="db2"><![CDATA[insert into crontaskparam (crontaskname, instancename, parameter, value, crontaskparamid) select 'ESCALATION', 'PIMDUE', 'ESCALATION', 'PIMDUE', nextval for crontaskparamseq from sysibm.sysdummy1 where not exists (select 1 from crontaskparam where crontaskname='ESCALATION' and instancename='PIMDUE' and parameter='ESCALATION')]]></sql>
    </freeform>
    <freeform description="messages pim/*">
      <sql target="sqlserver"><![CDATA[insert into maxmessages (msgkey, msggroup, value, displaymethod, options, maxmessagesid, msgid, prefix) select 'needili', 'pim', 'Enter the ILI run date, the MAOP and the wall thickness before you approve the pipeline integrity assessment.', 'MSGBOX', 2, next value for maxmessagesseq, 'BMXZZ7201E', 1 where not exists (select 1 from maxmessages where msggroup='pim' and msgkey='needili')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into maxmessages (msgkey, msggroup, value, displaymethod, options, maxmessagesid, msgid, prefix) select 'notapproved', 'pim', 'Approve the pipeline integrity assessment before you create its work orders.', 'MSGBOX', 2, next value for maxmessagesseq, 'BMXZZ7202E', 1 where not exists (select 1 from maxmessages where msggroup='pim' and msgkey='notapproved')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into maxmessages (msgkey, msggroup, value, displaymethod, options, maxmessagesid, msgid, prefix) select 'woexists', 'pim', 'Reassessment work order {0} already exists for this assessment.', 'MSGBOX', 2, next value for maxmessagesseq, 'BMXZZ7203E', 1 where not exists (select 1 from maxmessages where msggroup='pim' and msgkey='woexists')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into maxmessages (msgkey, msggroup, value, displaymethod, options, maxmessagesid, msgid, prefix) select 'nodigs', 'pim', 'No open immediate or scheduled ILI feature is waiting for a dig work order.', 'MSGBOX', 2, next value for maxmessagesseq, 'BMXZZ7204E', 1 where not exists (select 1 from maxmessages where msggroup='pim' and msgkey='nodigs')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into maxmessages (msgkey, msggroup, value, displaymethod, options, maxmessagesid, msgid, prefix) select 'frozenedit', 'pim', 'Assessment {0} is approved or superseded: its segment data, threats and ILI features cannot change. Create a new assessment to record repairs or new data.', 'MSGBOX', 2, next value for maxmessagesseq, 'BMXZZ7206E', 1 where not exists (select 1 from maxmessages where msggroup='pim' and msgkey='frozenedit')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into maxmessages (msgkey, msggroup, value, displaymethod, options, maxmessagesid, msgid, prefix) select 'frozen', 'pim', 'This pipeline integrity assessment is approved or superseded and is not recalculated. Create a new assessment to reassess the segment.', 'MSGBOX', 2, next value for maxmessagesseq, 'BMXZZ7205E', 1 where not exists (select 1 from maxmessages where msggroup='pim' and msgkey='frozen')]]></sql>
