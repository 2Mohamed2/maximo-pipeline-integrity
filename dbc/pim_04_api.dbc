<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script SYSTEM "script.dtd">
<!--
  Pipeline Integrity Management for Maximo Manage - optional part 4: REST/OSLC object structure.
  Restart Manage (or reload the object structure cache) after install.
  Every row is guarded (inserted only if missing): safe to re-run. Restart Manage after install so
  menus, grants and end points are reloaded.
-->
<script author="Mohamed Chihaoui" scriptname="pim_04_api_1.0.0">
  <description>PIM: MXPIMASSESS object structure (REST API) for assessments, threats and ILI features</description>
  <statements>
    <freeform description="object structure MXPIMASSESS">
      <sql target="sqlserver"><![CDATA[insert into maxintobject (intobjectname, description, selfreferencing, userdefined, changeby, changedate, maxintobjectid, langcode, hasld, queryonly, configurable, flatsupported, usewith, aliasconflict, authapp, loadqueryfromapp, primaryapi, completehierarchy, graphtype, useforassistant, trackrequests, usewithproduct, intendedfordataloading, module) select 'MXPIMASSESS', 'Pipeline integrity assessments with threats and ILI features', 0, 1, 'MAXADMIN', getdate(), next value for maxintobjectseq, 'EN', 0, 0, 1, 0, 'INTEGRATION', 0, 'PIMASSESS', 0, 0, 0, 0, 0, 0, 3, 0, 'PIM' where not exists (select 1 from maxintobject where intobjectname='MXPIMASSESS')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMASSESS', null, 1, 1, 1, 'MAXADMIN', getdate(), next value for maxintobjdetailseq, 1, null, 'PIMASSESS', 0, 0, 0, 0, 0, 0, 0 where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMASSESS')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMTHREAT', 'THREATS', 2, 2, 1, 'MAXADMIN', getdate(), next value for maxintobjdetailseq, 2, 1, 'PIMASSESS/PIMTHREAT', 0, 0, 0, 0, 0, 0, 0 where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMTHREAT')]]></sql>
      <sql target="sqlserver"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMANOM', 'ANOMALIES', 3, 3, 1, 'MAXADMIN', getdate(), next value for maxintobjdetailseq, 3, 1, 'PIMASSESS/PIMANOM', 0, 0, 0, 0, 0, 0, 0 where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMANOM')]]></sql>
      <sql target="oracle"><![CDATA[insert into maxintobject (intobjectname, description, selfreferencing, userdefined, changeby, changedate, maxintobjectid, langcode, hasld, queryonly, configurable, flatsupported, usewith, aliasconflict, authapp, loadqueryfromapp, primaryapi, completehierarchy, graphtype, useforassistant, trackrequests, usewithproduct, intendedfordataloading, module) select 'MXPIMASSESS', 'Pipeline integrity assessments with threats and ILI features', 0, 1, 'MAXADMIN', sysdate, maxintobjectseq.nextval, 'EN', 0, 0, 1, 0, 'INTEGRATION', 0, 'PIMASSESS', 0, 0, 0, 0, 0, 0, 3, 0, 'PIM' from dual where not exists (select 1 from maxintobject where intobjectname='MXPIMASSESS')]]></sql>
      <sql target="oracle"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMASSESS', null, 1, 1, 1, 'MAXADMIN', sysdate, maxintobjdetailseq.nextval, 1, null, 'PIMASSESS', 0, 0, 0, 0, 0, 0, 0 from dual where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMASSESS')]]></sql>
      <sql target="oracle"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMTHREAT', 'THREATS', 2, 2, 1, 'MAXADMIN', sysdate, maxintobjdetailseq.nextval, 2, 1, 'PIMASSESS/PIMTHREAT', 0, 0, 0, 0, 0, 0, 0 from dual where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMTHREAT')]]></sql>
      <sql target="oracle"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMANOM', 'ANOMALIES', 3, 3, 1, 'MAXADMIN', sysdate, maxintobjdetailseq.nextval, 3, 1, 'PIMASSESS/PIMANOM', 0, 0, 0, 0, 0, 0, 0 from dual where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMANOM')]]></sql>
      <sql target="db2"><![CDATA[insert into maxintobject (intobjectname, description, selfreferencing, userdefined, changeby, changedate, maxintobjectid, langcode, hasld, queryonly, configurable, flatsupported, usewith, aliasconflict, authapp, loadqueryfromapp, primaryapi, completehierarchy, graphtype, useforassistant, trackrequests, usewithproduct, intendedfordataloading, module) select 'MXPIMASSESS', 'Pipeline integrity assessments with threats and ILI features', 0, 1, 'MAXADMIN', current timestamp, nextval for maxintobjectseq, 'EN', 0, 0, 1, 0, 'INTEGRATION', 0, 'PIMASSESS', 0, 0, 0, 0, 0, 0, 3, 0, 'PIM' from sysibm.sysdummy1 where not exists (select 1 from maxintobject where intobjectname='MXPIMASSESS')]]></sql>
      <sql target="db2"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMASSESS', null, 1, 1, 1, 'MAXADMIN', current timestamp, nextval for maxintobjdetailseq, 1, null, 'PIMASSESS', 0, 0, 0, 0, 0, 0, 0 from sysibm.sysdummy1 where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMASSESS')]]></sql>
      <sql target="db2"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMTHREAT', 'THREATS', 2, 2, 1, 'MAXADMIN', current timestamp, nextval for maxintobjdetailseq, 2, 1, 'PIMASSESS/PIMTHREAT', 0, 0, 0, 0, 0, 0, 0 from sysibm.sysdummy1 where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMTHREAT')]]></sql>
      <sql target="db2"><![CDATA[insert into maxintobjdetail (intobjectname, objectname, relation, objectorder, processorder, userdefined, changeby, changedate, maxintobjdetailid, objectid, parentobjid, hierarchypath, excludeparentkey, deleteoncreate, propagateevent, invokeexecute, skipkeyupdate, excludebydefault, skipdeleteonreplace) select 'MXPIMASSESS', 'PIMANOM', 'ANOMALIES', 3, 3, 1, 'MAXADMIN', current timestamp, nextval for maxintobjdetailseq, 3, 1, 'PIMASSESS/PIMANOM', 0, 0, 0, 0, 0, 0, 0 from sysibm.sysdummy1 where not exists (select 1 from maxintobjdetail where intobjectname='MXPIMASSESS' and objectname='PIMANOM')]]></sql>
    </freeform>
  </statements>
</script>
